---
import "../styles/global.css";
import { withBase } from "../lib/url";
import Menu from "../components/Menu.astro";

interface Props {
  title: string;
  description: string;
  /** Chapter palette — retained as data only; the approved single ramp styles everything. */
  palette?: { surface: string; ink: string; accent: string };
  /** Menu corner: chapters/home use top-right; the map uses bottom-right. */
  menuPosition?: "top-right" | "bottom-right";
  /** Hide the floating menu (styleguide/internal pages). */
  noMenu?: boolean;
  /** Preload the page's LCP image so it starts with the HTML parse. */
  preloadImage?: string;
  /** Art-directed LCP preloads (chapter heroes: portrait vs landscape poster). */
  preloadImages?: { href: string; type?: string; media?: string }[];
}

const {
  title,
  description,
  menuPosition = "top-right",
  noMenu = false,
  preloadImage,
  preloadImages = [],
} = Astro.props;
// File-format builds report pathnames like /base/bakery.html — canonicalize
// to the extensionless URLs that GH Pages actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, ""),
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="theme-color" content="#1d1411" />
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {
      preloadImages.map((p) => (
        <link rel="preload" as="image" href={p.href} type={p.type} media={p.media} fetchpriority="high" />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Charles Nalle Walking Memorial" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("og.png"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    <script is:inline>
      // Progressive enhancement flag: scroll-reveal initial states apply
      // only when JS runs (no-JS users see everything, statically).
      document.documentElement.classList.add("js");
    </script>
    <a href="#main" class="skip-link" data-no-curtain>Skip to content</a>

    <main id="main">
      <slot />
    </main>

    {!noMenu && <Menu position={menuPosition} />}

    <!-- Curtain transition (signature #1) -->
    <div id="curtain-panel" class="curtain-panel" aria-hidden="true"></div>
    <div id="curtain-text" class="curtain-text" aria-hidden="true">
      <div id="curtain-text-content" class="flex flex-col">
        <p class="t-wordmark">Charles</p>
        <p class="t-wordmark self-end" style="margin-top:-0.06em">Nalle</p>
      </div>
    </div>

    <script>
      import { initCurtain } from "../lib/curtain";
      initCurtain();

      // Ambient videos load only when needed: near-viewport (IO) — the poster
      // is the instant paint, the film arrives when bandwidth allows.
      const lazyVids = document.querySelectorAll<HTMLVideoElement>(".lazy-video[data-src]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // A phone at a bronze plaque is on cellular. Ambient film is an
      // enhancement; the poster IS the finished painting, so on Save-Data or a
      // slow connection we simply never fetch the film.
      const conn = (navigator as any).connection;
      const thinPipe = Boolean(
        conn && (conn.saveData || /(^|-)(2g|slow-2g|3g)$/.test(String(conn.effectiveType || ""))),
      );
      if (lazyVids.length) {
        const load = (v: HTMLVideoElement) => {
          // `data-reduce-static` marks a film whose poster IS the finished
          // artwork — under reduced motion, or on a thin pipe, we never attach
          // the source and the still painting is what the visitor gets.
          if ((reducedMotion || thinPipe) && v.hasAttribute("data-reduce-static")) return;
          if (!v.src && v.dataset.src) {
            // The poster is attached HERE, not at init: setting it up front
            // fetched every below-fold poster on first paint (153KB of
            // archival still on the chapter path alone).
            if (v.dataset.poster && !v.poster) v.poster = v.dataset.poster;
            v.src = v.dataset.src;
            v.play().catch(() => {});
          }
        };
        // Films never race the first paint: start after the window load event
        const whenLoaded = (fn: () => void) => {
          if (document.readyState === "complete") fn();
          else window.addEventListener("load", fn, { once: true });
        };
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                whenLoaded(() => load(e.target as HTMLVideoElement));
                vio.unobserve(e.target);
              }
            }
          },
          { rootMargin: "200px" },
        );
        lazyVids.forEach((v) => vio.observe(v));
      }
    </script>
  </body>
</html>
