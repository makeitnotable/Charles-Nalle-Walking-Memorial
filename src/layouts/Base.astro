---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  /** Inline palette override for chapter pages */
  palette?: { surface: string; ink: string; accent: string };
}

const { title, description, palette } = Astro.props;
const paletteStyle = palette
  ? `--chapter-surface:${palette.surface};--chapter-ink:${palette.ink};--chapter-accent:${palette.accent};`
  : undefined;
// File-format builds report pathnames like /base/bakery.html — canonicalize
// to the extensionless URLs that GH Pages actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, ""),
  Astro.site,
);
---

<!doctype html>
<html lang="en" style={paletteStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="theme-color" content={palette?.surface ?? "#121212"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Charles Nalle Walking Memorial" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("og.png"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="paper min-h-dvh">
    <script is:inline>
      // Progressive enhancement flag: scroll-reveal initial states apply
      // only when JS runs (no-JS users see everything, statically).
      document.documentElement.classList.add("js");
    </script>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="relative z-30">
      <nav
        class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-6 py-5"
        aria-label="Site"
      >
        <a href={withBase("")} class="font-display text-lg tracking-wide">
          Charles Nalle <span class="opacity-60">Walking Memorial</span>
        </a>
        <div class="label-caps flex flex-wrap gap-x-5 gap-y-1" style="opacity: 1">
          <a href={withBase("map")} class="hover:underline">The Walk</a>
          <a href={withBase("bakery")} class="hover:underline">The Story</a>
          <a href={withBase("people")} class="hover:underline">The People</a>
          <a href={withBase("paintings")} class="hover:underline">The Paintings</a>
          <a href={withBase("about")} class="hover:underline">About</a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto max-w-2xl px-6 py-12 text-sm opacity-70">
      <p>
        Charles Nalle Walking Memorial · Troy, New York ·
        <a href={withBase("about")} class="underline">About this project</a>
      </p>
      <p class="mt-2">
        A collaboration of the Hart Cluett Museum, RPI, Brian Tolle Studio, and
        Notable Branding &amp; Design.
      </p>
    </footer>
  </body>
</html>
