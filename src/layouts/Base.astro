---
import "../styles/global.css";
import { withBase } from "../lib/url";
import Menu from "../components/Menu.astro";

interface Props {
  title: string;
  description: string;
  /** Chapter palette — retained as data only; the approved single ramp styles everything. */
  palette?: { surface: string; ink: string; accent: string };
  /** Menu corner: chapters/home use top-right; the map uses bottom-right. */
  menuPosition?: "top-right" | "bottom-right";
  /** Hide the floating menu (styleguide/internal pages). */
  noMenu?: boolean;
}

const { title, description, menuPosition = "top-right", noMenu = false } = Astro.props;
// File-format builds report pathnames like /base/bakery.html — canonicalize
// to the extensionless URLs that GH Pages actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, ""),
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="theme-color" content="#1d1411" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Charles Nalle Walking Memorial" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("og.png"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    <script is:inline>
      // Progressive enhancement flag: scroll-reveal initial states apply
      // only when JS runs (no-JS users see everything, statically).
      document.documentElement.classList.add("js");
    </script>
    <a href="#main" class="skip-link" data-no-curtain>Skip to content</a>

    <main id="main">
      <slot />
    </main>

    {!noMenu && <Menu position={menuPosition} />}

    <!-- Curtain transition (signature #1) -->
    <div id="curtain-panel" class="curtain-panel" aria-hidden="true"></div>
    <div id="curtain-text" class="curtain-text" aria-hidden="true">
      <div id="curtain-text-content" class="flex flex-col">
        <p class="type-wordmark">Charles</p>
        <p class="type-wordmark self-end" style="margin-top:-0.75rem">Nalle</p>
      </div>
    </div>

    <script>
      import { initCurtain } from "../lib/curtain";
      initCurtain();
    </script>
  </body>
</html>
