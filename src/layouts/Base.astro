---
import "../styles/global.css";
import { withBase } from "../lib/url";
import Menu from "../components/Menu.astro";
// v7 X1: the two curtain faces are preloaded so the wordmark/date lockup
// never reflows under the cover (Vite hashes the URLs — import them).
import caslonDisplayWoff2 from "@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url";
import caslonTextWoff2 from "@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Chapter palette — retained as data only; the approved single ramp styles everything. */
  palette?: { surface: string; ink: string; accent: string };
  /** Menu corner: chapters/home use top-right; the map uses bottom-right. */
  menuPosition?: "top-right" | "bottom-right";
  /** Hide the floating menu (styleguide/internal pages). */
  noMenu?: boolean;
  /**
   * Keep the page out of search results. Internal proof sheets are publicly
   * reachable by design (no server to gate them) but must never be indexed
   * alongside the memorial itself.
   */
  noIndex?: boolean;
  /** Preload the page's LCP image so it starts with the HTML parse. */
  preloadImage?: string;
  /** Art-directed LCP preloads (chapter heroes: portrait vs landscape poster). */
  preloadImages?: { href: string; type?: string; media?: string }[];
  /**
   * v14.5 (round 8 §5.1). "section" makes the ADDRESS BAR take the background
   * colour of the section under it as the reader scrolls, instead of whatever
   * Safari would fall back to. Only the five chapter routes ask for this.
   *
   * v20 (round 23, Wil, 2026-09-18). Two mechanisms carry it now, both in the
   * sampler below: `<body>` follows the section at the top edge (the round-21
   * rule from /map, so Safari's own tint on the minimized bar is the section's
   * colour rather than a static brown), and the in-flow `.edge-cover` paints
   * the same colour over whatever has scrolled past the top edge, so the glass
   * bar has a solid ground to show instead of the content beneath it. Nothing
   * is painted behind the bottom toolbar — his instruction — beyond the one
   * tint Safari applies to both bars from `<body>`.
   */
  topBar?: "section";
  /**
   * v14.7 (round 8 phase D). The colour the ROOT ELEMENT takes, which is what
   * iOS 26 paints behind the address bar AT REST.
   *
   * This is the one mechanism this round measured rather than assumed. Phase A:
   * "the top bar at rest is not a tint — it reads the page brown because
   * nothing exists above document offset 0, the root-background fallback."
   * That brown is `html { background: var(--color-primary-2) }` in global.css,
   * so changing the root background per route changes the bar, with no strip
   * and no opacity involved. Phase C proved the opposite about the 12px strip:
   * Safari does NOT read an `opacity: 0` element, and every opacity it does
   * read is one Wil can see.
   *
   * It cannot make the bar see-through — at rest the page's render surface
   * starts at document offset 0, which sits BELOW the bar, so there is nothing
   * there to show through on any page. A matched colour is the ceiling.
   *
   * Invisible on the page: <body> keeps its own background and paints every
   * pixel inside its box, so only the region outside it — the bar, and
   * overscroll — takes this.
   */
  rootFill?: "map";
}

const {
  title,
  description,
  menuPosition = "top-right",
  noMenu = false,
  noIndex = false,
  preloadImage,
  preloadImages = [],
  topBar,
  rootFill,
} = Astro.props;
// File-format builds report pathnames like /base/bakery.html — canonicalize
// to the extensionless URLs that GH Pages actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, ""),
  Astro.site,
);
---

<!doctype html>
<html lang="en" data-top-bar={topBar} data-root-fill={rootFill}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* v16 (Wil, 2026-09-18): the `?glass=1` review flag.

         Wil asked for items 1 and 3 on a review branch so v2 stays shippable
         while he checks them on his phone. This repo cannot do that: Pages
         deploys only from main/v2 (`concurrency: group: pages`) and Vercel was
         dropped for the zero-cost requirement, so a branch has no live URL.
         A query flag is the same guarantee by the means the repo does have —
         it is the `?striplab=` pattern phase C3 already used. Off the flag
         every route is byte-identical to today, which is also what keeps
         qa:snap a working safety net on the two riskiest pages.

         Parser-blocking and first in <head> so the attribute is on <html>
         before any rule that depends on it is matched. */
      (function () {
        try {
          var q = location.search;
          if (/(^|[?&])glass=1(&|$)/.test(q)) document.documentElement.dataset.glass = "1";
          /* v20 (round 23): the chapter cover's device flags. `?cover=off`
             removes the cover and the visor for a before/after on the phone;
             `?cover=track` drives the cover with the scroll timeline of device
             passes 2–4 instead of the script (`?cover=js` is the script, the
             default); `?visor=<px>` tries another height for the visor band
             (device pass 6; the default is 32); `?debug=1` adds a readout of
             which path is driving, what the browser supports and the viewport
             geometry. Inline, one page load; v2's defaults are untouched. */
          var c = /(^|[?&])cover=(off|js|track)(&|$)/.exec(q);
          if (c) document.documentElement.dataset.cover = c[2];
          if (/(^|[?&])debug=1(&|$)/.test(q)) document.documentElement.dataset.debug = "1";
          var vz = /(^|[?&])visor=(\d{1,3})(&|$)/.exec(q);
          if (vz) document.documentElement.style.setProperty("--edge-visor", vz[2] + "px");
          /* Device pass 8: `?scroll=inner` scrolls the chapter inside <main>
             and leaves the document still, so the region behind the top bar
             shows the canvas — <body>'s colour, the section at the top edge —
             static, painted by Safari itself, with no cover and no visor.
             Device pass 9 (Wil, 2026-09-19: "exactly what I wanted"): that is
             the DEFAULT on every chapter route wherever the bars exist — the
             same iOS gate as the cover's, `-webkit-touch-callout`, decided
             here so the attribute is on <html> before a rule is matched.
             `?scroll=doc` is the way back to the document scroller and the
             pass-7 cover, for a comparison on the phone. global.css has the
             rules and the trade (Safari's bars collapse only when the
             document scrolls, so here they stay expanded while reading). */
          var sm = /(^|[?&])scroll=(inner|doc)(&|$)/.exec(q);
          if (sm) document.documentElement.dataset.scroll = sm[2];
          else if (
            document.documentElement.dataset.topBar === "section" &&
            window.CSS &&
            CSS.supports &&
            CSS.supports("-webkit-touch-callout", "none")
          )
            document.documentElement.dataset.scroll = "inner";
        } catch (e) {}
      })();
    </script>
    {/* v9 V9-301 (Wil, 8/21: "there shouldn't be a black bar at the bottom or
        the top"). Without `viewport-fit=cover` iOS insets the page from the
        safe areas and paints those strips itself, which is what reads as bars
        above and below a full-bleed page like /map. With it, the page runs
        edge to edge and `env(safe-area-inset-*)` — already used by --ui-inset
        consumers — keeps chrome clear of the notch and home indicator. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {/* v7 I3: the CN mark — SVG first, PNG for older tabs, the multi-size ICO
        for legacy fetches, the home-screen icon, and the manifest (relative
        URLs inside, so the GH Pages base path just works). */}
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("favicon-16.png")} />
    <link rel="shortcut icon" href={withBase("favicon.ico")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <meta name="theme-color" content="#1d1411" />
    {/* v11.2 (Wil, 8/24: "the browser tool bar, and address bar allow the
        website to be full bleed or transparent"). No web API makes a browser's
        chrome transparent in a TAB — these two are the one place it is real.
        `site.webmanifest` already asks for `"display": "standalone"`; iOS needs
        the capable flag to honour it, and `black-translucent` then hands the
        page the status bar's pixels instead of reserving them. A memorial
        opened from a home screen — which is exactly how a QR at a bronze
        plaque tends to end up — runs edge to edge with no chrome at all. Zero
        effect in a normal tab. Safe only because --ui-inset now carries
        env(safe-area-inset-*): without that the corner menu would sit under
        the status bar the moment this was declared. */}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Charles Nalle" />
    <script is:inline>
      /* v11.2 (Wil, 8/24): "the browser tool bar, and address bar allow the
         website to be full bleed… Every page on the site should be full bleed."

         A browser paints its chrome in ONE colour, and this site has more than
         one ground — brown (--color-primary-2), the cream reading register
         (--ground-light) and the hero's near-black. Measured on a 390×844
         phone, the painted bottom row of the viewport is cream or near-white at
         four of the sampled scroll depths on a chapter page while the chrome
         stayed brown: that mismatch IS the black bar.

         So the tint follows the page. The bars sit at the TOP and BOTTOM
         edges, so only those two grounds can ever match one: a colour that
         matches the middle of the screen and neither edge is the worst of the
         three. Both edges are read; when they agree that is the answer, and
         when they disagree the one that owns more of the centre line wins, so
         the tint follows the section actually filling the screen and a tie
         falls to the bottom — where iOS parks its address bar. Nothing here
         reads a colour this stylesheet does not already paint, with one
         declared exception (v14.2, below): a section may state its own edge
         colour in a `data-edge-*` attribute.

         The curtain needs no special case: while it covers, it is the only
         hit-testable thing on the screen (pointer-events flips to auto), so a
         page transition tints itself. No JS, or a browser that ignores
         theme-color: the static meta above stands and nothing regresses.

         v14.2 (Wil, 9/16: "continue the artwork"). Over a painting there is no
         flat colour to read, so a section that knows what its edge should read
         declares it: `data-edge-top` / `data-edge-bottom` carry a #rrggbb —
         the heroes a colour sampled from the canvas's own top edge at build
         (scripts/build-edge-colors.mjs → src/data/edge-colors.json), the map
         its style's dark ground — and `data-edge-top-wide` /
         `data-edge-bottom-wide` override it from 768px up, where the landscape
         poster is a different crop. The nearest declaring ancestor of whatever
         sits at the edge wins; otherwise the section's ground decides. The
         literal value `transparent` is honoured (that edge then leaves the meta
         alone, so /chrome-test can show Safari's own fallback beside the
         rule); anything else is ignored. `data-chrome-tint-lock` on <html>
         (the test page's "loud theme-color" toggle) keeps this script's hands
         off the meta while it is set.

         v14.3 (Wil, 9/16: "remove any custom styling that adds a border and/or
         solid background fill behind the browser address bar / toolbar area …
         no stray 1px divider line"). Researched 8/26 (v12 item 17): Safari 26
         PARSES theme-color and then ignores it, tinting its bars from the
         <body> ground (then <html>) and from fixed/sticky elements against the
         viewport edges — so v12 pinned two fixed 2px `.chrome-tint` strips to
         the edges and this script painted them the resolved colour. On his
         iPhone (iOS 26, /map) Safari kept its bars black regardless, and the
         strips read as a thin coloured line across the top and bottom of the
         page: the divider he is reporting. They are gone. No web API makes a
         tab's chrome transparent or turns on Safari's floating/compact bar
         (both are the visitor's settings); all a page can do is paint no band
         of its own under the bars, and `viewport-fit=cover` already lets the
         content run under them. The meta stays and this sampler still keeps
         it current: Chrome for Android always paints a toolbar fill, and a
         fill that matches the adjacent section is Wil's fallback for exactly
         that case. */
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]:not([media])');
        if (!meta || !document.elementFromPoint) return;
        var queued = false;
        /* v14.3 (Wil, 9/16, item 3 — scroll jitter): sampled at most every
           SAMPLE_MS while events keep coming, with one trailing sample after
           the last. Measured at 390×844 under 4× CPU throttling, `sample` ran
           on every scroll frame (61–66 runs in a 60-frame scroll) at 4–6 ms a
           run on the chapter pages (max 44 ms) — two to ten hit tests
           (`elementsFromPoint`) and their computed styles — the largest
           per-frame script cost on the site, against 0.7 ms for GSAP's scroll
           handler and 0.08 ms for the corner menu's. What it produces is
           unchanged: the first event still samples at once, the settled state
           is always sampled, and a browser recolours its bar over ~300 ms. */
        var SAMPLE_MS = 100;
        var lastSample = 0;
        var trailing = 0;
        /* v19 (round 21): the last colour written to <body> on /map — and,
           since round 23, on the chapter routes — so a sample that resolves
           the same colour writes nothing. */
        var lastBody = "";

        function hex(c) {
          var m = String(c).match(/[\d.]+/g);
          if (!m || m.length < 3) return null;
          if (m.length > 3 && Number(m[3]) < 0.999) return null; // not opaque: keep looking
          return (
            "#" +
            m.slice(0, 3)
              .map(function (n) {
                return Math.round(Number(n)).toString(16).padStart(2, "0");
              })
              .join("")
          );
        }
        var ART = /^(img|video|canvas|svg|picture)$/;
        var WIDE = "(min-width: 768px)";
        /* v14.2: a declared edge colour is `#rrggbb` (lowercased) or the
           literal `transparent`; anything else is ignored. */
        function edgeValue(v) {
          if (!v) return null;
          v = String(v).trim().toLowerCase();
          return v === "transparent" || /^#[0-9a-f]{6}$/.test(v) ? v : null;
        }
        /* The nearest ancestor-or-self of `el` declaring `data-edge-<side>`,
           reading its `-wide` override first from 768px up. */
        function edgeAttr(el, side) {
          var host = el.closest && el.closest("[data-edge-" + side + "]");
          if (!host) return null;
          var wide = matchMedia(WIDE).matches
            ? edgeValue(host.getAttribute("data-edge-" + side + "-wide"))
            : null;
          return wide || edgeValue(host.getAttribute("data-edge-" + side));
        }
        /* v14.5 (round 8 §5.1) — the chapter pages' address bar.
           `groundAt` answers "what colour is at this point", which over a
           painting is the artwork's declared edge colour. This answers a
           different question: "what is the SECTION under this point painted?"
           It walks the hit stack, and from each hit walks up to the nearest
           section-level box — a <header>, <section>, <footer>, or a direct
           child of <main> — that has an OPAQUE background, and returns that.
           `data-edge-*` is deliberately ignored: those are sampled from the
           artwork, and what Wil asked for here is the section's own ground
           (#100a06 over the hero, the cream reading ground below it). */
        var SECTION = /^(header|section|footer|main)$/;
        /* v20 (round 23): what counts as a ground. The story transcript and
           the history section paint their cream on a `.ground-cream` <div>
           inside the <section>, not on the section itself, and the old walk
           fell straight past it to <body> — so over the cream the answer was
           the hero's brown. A register block counts now. So does <main>, which
           has carried the page ground since round 14, and it is the fallback
           ahead of <body>: on the chapter routes <body> is written FROM this
           function, so reading it back would be circular. */
        function isGround(n) {
          if (SECTION.test(n.tagName.toLowerCase())) return true;
          var parent = n.parentElement;
          if (parent && parent.tagName.toLowerCase() === "main") return true;
          return !!(n.classList && n.classList.contains("ground-cream"));
        }
        function sectionGroundAt(y) {
          var x = (window.innerWidth / 2) | 0;
          var stack = document.elementsFromPoint
            ? document.elementsFromPoint(x, y)
            : [document.elementFromPoint(x, y)];
          for (var i = 0; i < stack.length; i++) {
            var el = stack[i];
            if (!el || el === document.documentElement) break;
            for (var n = el; n && n !== document.body; n = n.parentElement) {
              if (!isGround(n)) continue;
              var c = hex(getComputedStyle(n).backgroundColor);
              if (c) return c;
            }
          }
          var main = document.getElementById("main");
          return (main && hex(getComputedStyle(main).backgroundColor)) || hex(getComputedStyle(document.body).backgroundColor);
        }
        /* Returns the colour the bar at `side` should take behind the point
           (w/2, y): the nearest declared edge colour, else the first flat
           ground in paint order, else <html>. The whole stack under the point
           is read (elementsFromPoint), not only the hit element's ancestors: a
           fixed strip with no ground of its own must not hide the section
           beneath it, while a covering panel — the curtain — still wins over
           whatever it covers, because it is met first. `art` reports whether a
           picture lies over the point (bleed-check reads it; the rule no
           longer does). */
        function groundAt(y, side) {
          var x = (window.innerWidth / 2) | 0;
          var stack = document.elementsFromPoint
            ? document.elementsFromPoint(x, y)
            : [document.elementFromPoint(x, y)];
          var art = false;
          for (var i = 0; i < stack.length; i++) {
            var el = stack[i];
            if (!el || el === document.documentElement) break;
            var declared = side ? edgeAttr(el, side) : null;
            if (declared) return { c: declared, art: false, hook: true };
            var cs = getComputedStyle(el);
            if (ART.test(el.tagName.toLowerCase()) || cs.backgroundImage !== "none") art = true;
            var c = hex(cs.backgroundColor);
            if (c) return { c: c, art: art, hook: false };
          }
          return { c: hex(getComputedStyle(document.documentElement).backgroundColor), art: art, hook: false };
        }
        /* A colour the meta can carry: a declared `transparent` cannot. */
        function flat(g) {
          return g && g.c && g.c !== "transparent" ? g.c : null;
        }
        function sample() {
          queued = false;
          lastSample = performance.now();
          var h = window.innerHeight;
          if (!h) return;
          /* 4px in from each edge: the walk rail is a 3px hairline pinned to
             the top of every chapter page and it is not the page's ground. */
          var top = groundAt(4, "top"), bottom = groundAt(h - 5, "bottom");
          var best = flat(bottom) || flat(top);
          if (flat(top) && flat(bottom) && top.c !== bottom.c) {
            /* Two colours share the screen. Whichever owns more of the centre
               line owns the page the visitor is reading; the other is on its
               way in or out. A centre point is read as its section's TOP edge
               first, so a hero that owns both edges resolves to its own
               painting's colour — the top bar is the one Chrome for Android
               paints from this meta. Ties keep `bottom`, where iOS parks its
               bar. (v14.2: the old art-based tiebreak is gone — over artwork a
               declared colour now stands in for the flat ground it never had.) */
            var nTop = 0, nBottom = 0;
            for (var f = 0.2; f < 0.81; f += 0.2) {
              var y = (h * f) | 0;
              if (groundAt(y, "top").c === top.c) nTop++;
              else if (groundAt(y, "bottom").c === bottom.c) nBottom++;
            }
            best = nTop > nBottom ? top.c : bottom.c;
          }
          var docEl = document.documentElement;
          /* v14.5 (round 8 §5.1): on the chapter routes the top strip carries
             the section's own ground as an OPAQUE colour, which is what iOS 26
             reads for the address bar, and Chrome for Android takes the same
             colour through the meta. The strip is 4px, opacity 0 and never
             hit-tested, so this paints nothing: if Safari declines to read it,
             the page looks exactly as it does today. Everywhere else the
             two-edge rule above is untouched. */
          /* v14.9 (round 8 phase F, Wil 2026-09-18): "it is supposed to remain
             this same solid fill color as you are scrolling down … it currently
             transitions into a see-through fill which it should never have
             done." The strip write that lived here is GONE. It set an inline
             background-color from the section under the top edge, and an inline
             style beats the stylesheet — so the one element that is supposed to
             hold the hero's #100a06 for the whole page was being repainted per
             section on every scroll frame. The colour is now static in
             global.css and nothing may overwrite it.
             `best = sc` stays: that is the theme-color meta, which is Chrome
             for Android's toolbar fill and the one device where a section-
             matched bar is free (phase C4). It never touches the strip. */
          if (docEl.dataset.topBar === "section") {
            var sc = sectionGroundAt(4);
            if (sc) best = sc;
          }
          /* v19 (round 21, Wil, 2026-09-18): "the gray gradient overlay …
             behind and around the top address bar does not disappear when
             scrolling down into the section below the map." Safari 26 tints
             its bars from <body>'s background-color (round 8 phase E, measured
             on his phone; theme-color is parsed and ignored), and /map's body
             has been the map's grey #353535 since phase D/E so the at-rest bar
             matched the canvas. The tint outlives the map: minimized and
             scrolled, it is still grey over the brown index. The page cannot
             remove Safari's tint; it can hand it a colour, and phase A2 test
             C4a measured that a live colour change on an element that stays
             in the tree is the one thing that moves it. So on /map, and only
             there, <body> follows the colour this sampler already resolves —
             the map's grey while the map owns the screen, the ground's brown
             once the index does ("if you have to use a color use this one").
             Nothing paints on the page: <main> covers <body> (round 14), so
             the colour reaches only the bar region and overscroll. One colour
             for both bars is the accepted cost, as it was for the chapter
             routes' static fill. Every other route keeps its static body. */
          /* v20 (round 23, Wil, 2026-09-18, his three chapter screenshots):
             the five chapter routes join /map. Their static hero brown was his
             round-8 instruction, taken when the alternative retinted the bottom
             toolbar; today's ask is the section's colour behind the top bar,
             and this tint is the only lever Safari offers for the bar itself,
             so the bottom toolbar's share of it is the residue he was told
             about — nothing is PAINTED behind the bottom toolbar (see
             .edge-cover in global.css for what is painted, and where). At rest
             this writes the hero's own #100a06, which the stylesheet already
             carries, so nothing moves. */
          var tracks = docEl.dataset.rootFill === "map" || docEl.dataset.topBar === "section";
          if (tracks && best && best !== lastBody) {
            lastBody = best;
            document.body.style.backgroundColor = best;
          }
          if (docEl.dataset.topBar === "section") paintCover(best);
          if (best && !docEl.dataset.chromeTintLock && best !== meta.getAttribute("content")) {
            meta.setAttribute("content", best);
          }
        }
        /* v20 (round 23): the chapter cover (`.edge-cover`, global.css) — the
           section's ground painted over what has scrolled past the top edge,
           which is what Safari's minimized bar shows through its glass.

           Six device passes (2026-09-18/19, Wil's iPhone, iOS 26.6): the
           region behind the bars shows only SCROLLED page paint; a pinned box
           — fixed or sticky — is clipped at the viewport and never paints
           there; Safari's own tint from <body> is a gradient, not a fill; and
           a box moved from the main thread sits a frame behind the compositor
           while the page moves, by speed × a frame (10–40px in his crops),
           which no feather could hide: "there should never be a moment where
           the area is see-through".

           Pass 6, the answer: aim the cover INSIDE the page, not at its edge.
           The walk rail is now the VISOR — a fixed, opaque band of the
           section's colour, `--edge-visor` tall (32px then), its 3px line at
           the bottom — and the cover's bottom edge is aimed at the visor's
           middle. A frame of lag in either direction moves that edge up or
           down INSIDE the visor, where the fixed band hides it; the bar
           region above and the page below are the only things visible, and
           both stay solid. The script also LEADS the scroll by its measured
           speed × about a frame and a half, so the edge stays near the
           middle at speed and the visor's half-height absorbs the residual.
           At rest the edge settles in the middle, and nothing depends on
           where exactly. Colour: the sampler writes the section's colour to
           the cover and the visor alike, instantly, as he asked; Safari's
           animated tint over them is the same colour.

           Pass 7 (Wil, 2026-09-19, 06:15: "even better but now it's too
           tall", and "a little flicker … both fast and slow"). The two asks
           pull against each other — the band's height WAS the tolerance,
           half above the aim for lag and half below for the lead — so the
           geometry now spends all of it on the one failure he can see. The
           cover aims at the TOP OF THE VISOR'S LINE (its foot), not its
           middle: the whole band above the line is room for the edge to lag
           upward before the bar region shows content, and an edge that
           overshoots downward only runs behind the line (the rail, z-index
           900, stays above the cover, and the band's colour is already
