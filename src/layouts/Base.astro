---
import "../styles/global.css";
import { withBase } from "../lib/url";
import Menu from "../components/Menu.astro";
// v7 X1: the two curtain faces are preloaded so the wordmark/date lockup
// never reflows under the cover (Vite hashes the URLs — import them).
import caslonDisplayWoff2 from "@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url";
import caslonTextWoff2 from "@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Chapter palette — retained as data only; the approved single ramp styles everything. */
  palette?: { surface: string; ink: string; accent: string };
  /** Menu corner: chapters/home use top-right; the map uses bottom-right. */
  menuPosition?: "top-right" | "bottom-right";
  /** Hide the floating menu (styleguide/internal pages). */
  noMenu?: boolean;
  /**
   * Keep the page out of search results. Internal proof sheets are publicly
   * reachable by design (no server to gate them) but must never be indexed
   * alongside the memorial itself.
   */
  noIndex?: boolean;
  /** Preload the page's LCP image so it starts with the HTML parse. */
  preloadImage?: string;
  /** Art-directed LCP preloads (chapter heroes: portrait vs landscape poster). */
  preloadImages?: { href: string; type?: string; media?: string }[];
}

const {
  title,
  description,
  menuPosition = "top-right",
  noMenu = false,
  noIndex = false,
  preloadImage,
  preloadImages = [],
} = Astro.props;
// File-format builds report pathnames like /base/bakery.html — canonicalize
// to the extensionless URLs that GH Pages actually serves.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, ""),
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {/* v7 I3: the CN mark — SVG first, PNG for older tabs, the multi-size ICO
        for legacy fetches, the home-screen icon, and the manifest (relative
        URLs inside, so the GH Pages base path just works). */}
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("favicon-16.png")} />
    <link rel="shortcut icon" href={withBase("favicon.ico")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <meta name="theme-color" content="#1d1411" />
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={caslonDisplayWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={caslonTextWoff2} crossorigin />
    <script is:inline>
      /* v7 X1 — the Crossing's second half must be on screen BEFORE first
         paint. Page A sets `cnwm-curtain` in sessionStorage as it covers; this
         parser-blocking script reads it and paints the panel covered (CSS
         `.curtain-covered`) so page B never shows an uncovered frame before
         the deferred module runs the hold + reveal. Reduced motion never
         covers. Fail-open: if the module never runs, uncover at 3 s. */
      (function () {
        try {
          if (
            sessionStorage.getItem("cnwm-curtain") &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            document.documentElement.classList.add("curtain-covered");
            setTimeout(function () {
              document.documentElement.classList.remove("curtain-covered");
            }, 3000);
          }
        } catch (e) {}
      })();
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {
      preloadImages.map((p) => (
        <link rel="preload" as="image" href={p.href} type={p.type} media={p.media} fetchpriority="high" />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Charles Nalle Walking Memorial" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("og.png"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Charles Nalle Walking Memorial — Troy, New York, April 27, 1860" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(withBase("og.png"), Astro.site)} />
  </head>
  <body class="min-h-dvh">
    <script is:inline>
      // Progressive enhancement flag: scroll-reveal initial states apply
      // only when JS runs (no-JS users see everything, statically).
      document.documentElement.classList.add("js");
    </script>
    <a href="#main" class="skip-link" data-no-curtain>Skip to content</a>

    <!-- Curtain transition (signature #1). v7 X1: FIRST in <body> — position:
         fixed cares nothing for order, but the parser paints <main> before it
         reaches the end of the document, so a panel declared last let page B's
         hero flash for a frame or two under 4× CPU. Here it exists before any
         content paints; the head script has already set `.curtain-covered`. -->
    <div id="curtain-panel" class="curtain-panel" aria-hidden="true"></div>
    <div id="curtain-text" class="curtain-text" aria-hidden="true">
      <div id="curtain-text-content" class="flex flex-col">
        <p class="t-wordmark">Charles</p>
        <p class="t-wordmark self-end" style="margin-top:-0.06em">Nalle</p>
      </div>
    </div>
    <script is:inline>
      /* v7 X1 — write the covered label synchronously, right after its
         element exists, so the first painted frame already carries the
         destination (same markup as curtain.ts setLabel). */
      (function () {
        try {
          if (!document.documentElement.classList.contains("curtain-covered")) return;
          var c = document.getElementById("curtain-text-content");
          var label = sessionStorage.getItem("cnwm-curtain-label") || "";
          var withDate = !!sessionStorage.getItem("cnwm-curtain-date");
          if (!c || !label) return;
          var esc = function (t) {
            return t.replace(/[&<>"]/g, function (ch) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch];
            });
          };
          c.innerHTML = withDate
            ? '<p class="t-crossing text-center">April 27, 1860</p><p class="t-meta text-center" style="margin-top:1.25rem">' + esc(label) + "</p>"
            : '<p class="t-wordmark text-center">' + esc(label) + "</p>";
        } catch (e) {}
      })();
    </script>


    {/* v7 V7-081: the menu is rendered BEFORE <main> so it is the first real
        tab stop (it is visually first); position:fixed makes DOM order free. */}
    {!noMenu && <Menu position={menuPosition} />}

    <main id="main">
      <slot />
    </main>

    <script>
      import { initCurtain } from "../lib/curtain";
      initCurtain();

      // Ambient videos load only when needed: near-viewport (IO) — the poster
      // is the instant paint, the film arrives when bandwidth allows.
      const lazyVids = document.querySelectorAll<HTMLVideoElement>(".lazy-video[data-src]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // A phone at a bronze plaque is on cellular. Ambient film is an
      // enhancement; the poster IS the finished painting, so on Save-Data or a
      // slow connection we simply never fetch the film. Evaluated at FETCH
      // time, not init: effectiveType starts at "4g" until the estimator has
      // samples, which is exactly the window the old check sat in — E7 caught
      // every chapter pulling its reveal film through the emulated thin pipe.
      // The downlink floor backstops the type label (Slow-4G measures ~1.6).
      const thinPipe = () => {
        const conn = (navigator as any).connection;
        if (!conn) return false;
        if (conn.saveData) return true;
        if (/(^|-)(2g|slow-2g|3g)$/.test(String(conn.effectiveType || ""))) return true;
        return typeof conn.downlink === "number" && conn.downlink > 0 && conn.downlink < 3;
      };
      if (lazyVids.length) {
        const load = (v: HTMLVideoElement) => {
          // `data-reduce-static` marks a film whose poster IS the finished
          // artwork — under reduced motion, or on a thin pipe, we never attach
          // the source and the still painting is what the visitor gets.
          if ((reducedMotion || thinPipe()) && v.hasAttribute("data-reduce-static")) return;
          if (!v.src && v.dataset.src) {
            // The poster is attached HERE, not at init: setting it up front
            // fetched every below-fold poster on first paint (153KB of
            // archival still on the chapter path alone).
            if (v.dataset.poster && !v.poster) v.poster = v.dataset.poster;
            v.src = v.dataset.src;
            v.play().catch(() => {});
          }
        };
        // Films never race the first paint: start after the window load event
        const whenLoaded = (fn: () => void) => {
          if (document.readyState === "complete") fn();
          else window.addEventListener("load", fn, { once: true });
        };
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                whenLoaded(() => load(e.target as HTMLVideoElement));
                vio.unobserve(e.target);
              }
            }
          },
          { rootMargin: "200px" },
        );
        lazyVids.forEach((v) => vio.observe(v));
      }
    </script>
  </body>
</html>
