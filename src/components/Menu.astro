---
// Corner-notched menu (approved signature #5, ported from legacy
// MenuOverlay.jsx). 72×72 hamburger, three primary-10 bars (third shorter),
// opens in place with back.out(1.7) to a bordered panel.
// The multi-door IA (People / Paintings / The Walk) folds into the approved
// panel below the chapter list, same voice.
import { withBase } from "../lib/url";

interface Props {
  /** "top-right" (default) or "bottom-right" (map page) */
  position?: "top-right" | "bottom-right";
}
const { position = "top-right" } = Astro.props;

const chapters = [
  { label: "1. Bakery", slug: "bakery", name: "Bakery" },
  { label: "2. Commissioner's Office", slug: "commissioners-office", name: "Commissioner's Office" },
  { label: "3. Mansion", slug: "mansion", name: "Mansion" },
  { label: "4. Ferry", slug: "ferry", name: "Ferry" },
  { label: "5. Barbershop", slug: "barbershop", name: "Barbershop" },
];
const posClass = position === "bottom-right" ? "bottom-3 right-3" : "top-3 right-3";
const notchClass =
  position === "bottom-right"
    ? "rounded-tl-xl rounded-tr-xl rounded-bl-xl rounded-br-4xl"
    : "rounded-tl-xl rounded-tr-xl rounded-br-xl rounded-bl-4xl";
---

<div
  class={`cnwm-menu fixed ${posClass} z-[1000]`}
  data-position={position}
>
  <!-- Hamburger -->
  <button
    type="button"
    class={`cnwm-menu-burger flex h-[72px] w-[72px] cursor-pointer items-center justify-center border-2 border-primary-6 bg-primary-3 ${notchClass}`}
    aria-label="Open menu"
    aria-expanded="false"
  >
    <span class="flex w-full flex-col items-center gap-2" aria-hidden="true">
      <span class="cnwm-bar block h-0.5 w-8 rounded-full bg-primary-10"></span>
      <span class="cnwm-bar block h-0.5 w-8 rounded-full bg-primary-10"></span>
      <span class="cnwm-bar ml-4.5 block h-0.5 w-6 self-start rounded-full bg-primary-10"></span>
    </span>
  </button>

  <!-- Panel -->
  <nav
    class="cnwm-menu-panel hidden rounded-xl border-2 border-primary-6 bg-primary-3"
    aria-label="Site"
  >
    {position === "top-right" && (
      <button
        type="button"
        class="cnwm-menu-close flex w-full cursor-pointer items-center justify-center rounded-t-xl border-b-2 border-primary-6 bg-primary-3 py-6 transition-colors duration-300 hover:bg-primary-5"
        aria-label="Close menu"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M21 1L1 21M1 1L21 21" stroke="#F26835" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    )}
    <div class="flex flex-col items-start p-8 text-primary-11">
      <div class="ml-5 flex w-full flex-col gap-6 text-left">
        <a href={withBase("")} class="text-lg transition-colors duration-300 hover:text-primary-9" data-curtain-label="Home">Home</a>
        <div class="ml-3 flex flex-col gap-6">
          {chapters.map((c) => (
            <a
              href={withBase(c.slug)}
              class="text-lg text-left transition-colors duration-300 hover:text-primary-9"
              data-curtain-label={c.name}
              data-curtain-date
            >
              {c.label}
            </a>
          ))}
          <a href={withBase("map")} class="-ml-3 text-lg transition-colors duration-300 hover:text-primary-9" data-curtain-label="The Walk">The Walk</a>
          <a href={withBase("people")} class="-ml-3 text-lg transition-colors duration-300 hover:text-primary-9" data-curtain-label="The People">The People</a>
          <a href={withBase("paintings")} class="-ml-3 text-lg transition-colors duration-300 hover:text-primary-9" data-curtain-label="The Paintings">The Paintings</a>
          <a href={withBase("about")} class="-ml-3 text-lg transition-colors duration-300 hover:text-primary-9" data-curtain-label="About">About</a>
        </div>
      </div>
    </div>
    {position === "bottom-right" && (
      <button
        type="button"
        class="cnwm-menu-close flex w-full cursor-pointer items-center justify-center rounded-b-xl border-t-2 border-primary-6 bg-primary-3 py-6 transition-colors duration-300 hover:bg-primary-5"
        aria-label="Close menu"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M21 1L1 21M1 1L21 21" stroke="#F26835" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    )}
  </nav>
</div>

<script>
  import gsap from "gsap";

  function setup(root: HTMLElement) {
    const burger = root.querySelector<HTMLButtonElement>(".cnwm-menu-burger")!;
    const panel = root.querySelector<HTMLElement>(".cnwm-menu-panel")!;
    const closeBtns = root.querySelectorAll<HTMLButtonElement>(".cnwm-menu-close");
    const bars = root.querySelectorAll<HTMLElement>(".cnwm-bar");
    const origin =
      root.dataset.position === "bottom-right" ? "bottom right" : "top right";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const open = () => {
      burger.setAttribute("aria-expanded", "true");
      burger.classList.add("hidden");
      panel.classList.remove("hidden");
      if (!reduced) {
        gsap.fromTo(
          panel,
          { scale: 0.8, opacity: 0, transformOrigin: origin },
          { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.7)" },
        );
      }
      (panel.querySelector("a, button") as HTMLElement | null)?.focus();
    };

    const close = () => {
      burger.setAttribute("aria-expanded", "false");
      const done = () => {
        panel.classList.add("hidden");
        burger.classList.remove("hidden");
        if (!reduced) {
          gsap.fromTo(
            burger,
            { scale: 0.8, opacity: 0, rotation: -180 },
            { scale: 1, opacity: 1, rotation: 0, duration: 0.5, ease: "back.out(1.7)" },
          );
          gsap.fromTo(
            bars,
            { scaleX: 0, opacity: 0 },
            { scaleX: 1, opacity: 1, duration: 0.3, stagger: 0.1, delay: 0.2, ease: "back.out(2)" },
          );
        }
        burger.focus();
      };
      if (reduced) done();
      else
        gsap.to(panel, {
          scale: 0.8,
          opacity: 0,
          duration: 0.3,
          ease: "back.in(1.7)",
          transformOrigin: origin,
          onComplete: done,
        });
    };

    burger.addEventListener("click", open);
    closeBtns.forEach((b) => b.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.classList.contains("hidden")) close();
    });
  }

  document.querySelectorAll<HTMLElement>(".cnwm-menu").forEach(setup);
</script>
