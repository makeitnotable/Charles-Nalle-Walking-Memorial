---
// Corner-notched menu (approved signature #5, ported from legacy
// MenuOverlay.jsx). 72×72 hamburger, three primary-10 bars (third shorter),
// opens in place with back.out(1.7) to a bordered panel.
// The multi-door IA (People / Paintings / The Walk) folds into the approved
// panel below the chapter list, same voice.
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { withBase } from "../lib/url";

interface Props {
  /** "top-right" (default) or "bottom-right" (map page) */
  position?: "top-right" | "bottom-right";
}
const { position = "top-right" } = Astro.props;

/* Generated from the content collection — the v3 hardcoded list had already
 * drifted to "Mansion" and "Ferry" while the map said something else. There is
 * one source for a place name now: `name.short`. */
const chapters = (await getCollection("chapters"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    slug: e.id,
    order: String(e.data.order).padStart(2, "0"),
    name: e.data.name.short,
  }));
/* One inset for every floating element on the site. The burger used to sit at
 * right:12px while page content sat on a 56px gutter — 124px adrift on a 1440
 * screen, anchored to nothing. It is on the gutter now. */
const posClass =
  position === "bottom-right"
    ? "bottom-[var(--ui-inset)] right-[var(--ui-inset)]"
    : "top-[var(--ui-inset)] right-[var(--ui-inset)]";
const notchClass =
  position === "bottom-right"
    ? "rounded-tl-xl rounded-tr-xl rounded-bl-xl rounded-br-4xl"
    : "rounded-tl-xl rounded-tr-xl rounded-br-xl rounded-bl-4xl";
---

{/* The scrim is what turns this from a collision into a layer. Open over the
    map, the panel sat on top of live markers and sliced them in half — two
    interactive things competing for the same pixels. Behind a scrim it reads
    as what it is: a dialog over a dimmed page. It also gives the panel a
    click-away target it never had. */}
<div class="cnwm-menu-scrim" hidden aria-hidden="true"></div>

<div
  class={`cnwm-menu fixed ${posClass} z-[1000]`}
  data-position={position}
>
  <!-- Hamburger -->
  <button
    type="button"
    class={`cnwm-menu-burger flex h-[72px] w-[72px] cursor-pointer items-center justify-center border border-primary-7 bg-primary-3 ${notchClass}`}
    aria-label="Open menu"
    aria-expanded="false"
  >
    <span class="flex w-full flex-col items-center gap-2" aria-hidden="true">
      <span class="cnwm-bar block h-0.5 w-8 rounded-full bg-primary-10"></span>
      <span class="cnwm-bar block h-0.5 w-8 rounded-full bg-primary-10"></span>
      <span class="cnwm-bar ml-4.5 block h-0.5 w-6 self-start rounded-full bg-primary-10"></span>
    </span>
  </button>

  <!-- Panel -->
  <nav
    class="cnwm-menu-panel hidden overflow-y-auto rounded-[12px] border border-primary-7 bg-primary-3"
    aria-label="Site"
  >
    {position === "top-right" && (
      <button
        type="button"
        class="cnwm-menu-close flex w-full cursor-pointer items-center justify-center rounded-t-[12px] border-b border-primary-7 bg-primary-3 py-4 transition-colors duration-300 hover:bg-primary-5"
        aria-label="Close menu"
      >
        <Icon name="close" class="text-primary-9" />
      </button>
    )}
    {/* 20rem gave the inner column 256px, and "COMMISSIONER'S" at the old
        title step measured 266px — the menu's own longest label overflowed and
        was clipped by the edge of the screen. */}
    <div class="cnwm-menu-list flex w-[min(82vw,23rem)] flex-col p-8">
      <a
        href={withBase("")}
        class="t-meta transition-colors hover:text-neutral-12"
        data-curtain-label="Home"
        style="transition-duration: var(--dur-fast)">Home</a
      >

      <ul class="mt-8 space-y-5">
        {chapters.map((c) => (
          <li>
            <a
              href={withBase(c.slug)}
              class="group flex items-baseline gap-4"
              data-curtain-label={c.name}
              data-curtain-date
            >
              <span class="t-meta w-8 shrink-0">{c.order}</span>
              <span
                class="t-title-sm transition-colors group-hover:text-primary-9"
                style="transition-duration: var(--dur-fast)"
              >
                {c.name}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <ul class="rule-top mt-8 space-y-4 pt-8">
        <li><a href={withBase("map")} class="link-meta t-meta" data-curtain-label="The Walk">The walk<Icon name="arrow" size="sm" /></a></li>
        <li><a href={withBase("people")} class="link-meta t-meta" data-curtain-label="The People">The people<Icon name="arrow" size="sm" /></a></li>
        <li><a href={withBase("paintings")} class="link-meta t-meta" data-curtain-label="The Paintings">The paintings<Icon name="arrow" size="sm" /></a></li>
        <li><a href={withBase("about")} class="link-meta t-meta" data-curtain-label="About">About<Icon name="arrow" size="sm" /></a></li>
      </ul>
    </div>
    {position === "bottom-right" && (
      <button
        type="button"
        class="cnwm-menu-close flex w-full cursor-pointer items-center justify-center rounded-b-[12px] border-t border-primary-7 bg-primary-3 py-6 transition-colors duration-300 hover:bg-primary-5"
        aria-label="Close menu"
      >
        <Icon name="close" class="text-primary-9" />
      </button>
    )}
  </nav>
</div>

<script>
  import gsap from "gsap";

  function setup(root: HTMLElement) {
    const burger = root.querySelector<HTMLButtonElement>(".cnwm-menu-burger")!;
    const panel = root.querySelector<HTMLElement>(".cnwm-menu-panel")!;
    const closeBtns = root.querySelectorAll<HTMLButtonElement>(".cnwm-menu-close");
    const bars = root.querySelectorAll<HTMLElement>(".cnwm-bar");
    const scrim = document.querySelector<HTMLElement>(".cnwm-menu-scrim");
    const origin =
      root.dataset.position === "bottom-right" ? "bottom right" : "top right";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const open = () => {
      burger.setAttribute("aria-expanded", "true");
      burger.classList.add("hidden");
      panel.classList.remove("hidden");
      if (scrim) scrim.hidden = false;
      if (!reduced) {
        gsap.fromTo(
          panel,
          { scale: 0.8, opacity: 0, transformOrigin: origin },
          { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.7)" }, // the one documented overshoot
        );
      }
      (panel.querySelector("a, button") as HTMLElement | null)?.focus();
    };

    const close = () => {
      burger.setAttribute("aria-expanded", "false");
      const done = () => {
        panel.classList.add("hidden");
        if (scrim) scrim.hidden = true;
        burger.classList.remove("hidden");
        if (!reduced) {
          gsap.fromTo(
            burger,
            { scale: 0.8, opacity: 0, rotation: -180 },
            { scale: 1, opacity: 1, rotation: 0, duration: 0.3, ease: "power2.out" },
          );
          gsap.fromTo(
            bars,
            { scaleX: 0, opacity: 0 },
            { scaleX: 1, opacity: 1, duration: 0.3, stagger: 0.06, delay: 0.15, ease: "power2.out" },
          );
        }
        burger.focus();
      };
      if (reduced) done();
      else
        gsap.to(panel, {
          scale: 0.8,
          opacity: 0,
          duration: 0.3,
          ease: "power2.in",
          transformOrigin: origin,
          onComplete: done,
        });
    };

    burger.addEventListener("click", open);
    closeBtns.forEach((b) => b.addEventListener("click", close));
    scrim?.addEventListener("click", () => {
      if (!panel.classList.contains("hidden")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.classList.contains("hidden")) close();
    });
  }

  document.querySelectorAll<HTMLElement>(".cnwm-menu").forEach(setup);

  /* The burger floats over the page, so on a phone it landed on live body copy
     — the v3 census caught it clipping words mid-sentence on ten screens. It
     now retreats while the reader scrolls forward and returns on any upward
     scroll, at rest, or whenever the panel is open. */
  (() => {
    const menus = Array.from(document.querySelectorAll<HTMLElement>(".cnwm-menu"));
    if (!menus.length) return;
    let last = window.scrollY;
    const set = (hidden: boolean) => {
      for (const m of menus) {
        const open = m.querySelector(".cnwm-menu-panel")?.classList.contains("hidden") === false;
        m.dataset.hidden = String(hidden && !open);
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        // Reading forward hides it and KEEPS it hidden — no idle restore, or it
        // reappears on top of the paragraph you stopped at. Any upward scroll,
        // or returning near the top, brings it straight back.
        if (y > last + 4 && y > 240) set(true);
        else if (y < last - 4 || y <= 240) set(false);
        last = y;
      },
      { passive: true },
    );
  })();
</script>
