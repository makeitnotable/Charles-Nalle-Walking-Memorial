---
/**
 * The walk rail — a slim persistent bar showing where you are along the five
 * stops. It is the one thing museos has that this site did not: a permanent
 * answer to "how far in am I?".
 *
 * Five segments pinned to the top edge, full-bleed, 3px. Past stops are lit
 * dim, the current one is lit, ahead is a hairline. Every segment is a real
 * link with a real label, so it is wayfinding rather than decoration — and at
 * 3px tall it never competes with the page.
 */
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";

interface Props {
  /** 1-5, or 0 on the map where the whole walk is ahead of you. */
  current?: number;
  /**
   * Links, or a read-only indicator — and read-only is now the default.
   *
   * A 24px interactive strip pinned across the top edge swallowed whatever sat
   * under it: on the map it ate pans starting at the canvas edge, and on a
   * chapter page the sticky spine scrolled beneath it and lost its top link to
   * a transparent bar. The rail is a progress READOUT; the corner menu, the
   * chapter spine and the onward CTA are the navigation. At 3px and inert it
   * cannot collide with anything.
   */
  interactive?: boolean;
}
const { current = 0, interactive = false } = Astro.props;

const stops = (await getCollection("chapters"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ slug: e.id, order: e.data.order, name: e.data.name.short }));
---

<nav
  class:list={["walk-rail", interactive ? "walk-rail-nav" : "walk-rail-static"]}
  aria-label="Progress along the walk"
>
  {
    stops.map((s) =>
      interactive ? (
        <a
          href={withBase(s.slug)}
          data-curtain-label={s.name}
          data-curtain-date
          class="walk-seg"
          data-state={s.order < current ? "past" : s.order === current ? "now" : "ahead"}
          aria-current={s.order === current ? "step" : undefined}
        >
          <span class="sr-only">
            Stop {s.order} of {stops.length} — {s.name}
          </span>
        </a>
      ) : (
        <span
          class="walk-seg"
          data-state={s.order < current ? "past" : s.order === current ? "now" : "ahead"}
        />
      ),
    )
  }
</nav>
