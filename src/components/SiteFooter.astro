---
/**
 * THE footer band — identical on every page.
 * Full-bleed hairline, then one row on the shell: credit left, lateral links
 * centre, share right. v3 shipped three different footers using three type
 * sizes each; there is now one.
 *
 * It used to reserve 112px of RIGHT padding for the corner menu, which lives at
 * the TOP of every page that has this footer — so the Share control hung 112px
 * in from the edge while every other element on the page sat on the gutter.
 * The only floating element that ever reaches the footer is the chapter
 * mini-player, bottom-left, and only chapters get that clearance now.
 */
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { withBase } from "../lib/url";

interface Props {
  /** Omit the page you are already on. */
  hide?: "people" | "paintings" | "about" | "map";
  /** Chapter pages offer a share control; index pages do not need one. */
  share?: boolean;
  /**
   * Only chapter pages run narration, so only they need the bottom-left lane
   * kept clear for the mini-player. /people, /paintings and /about were
   * reserving 112px for a control that does not exist on them.
   */
  audio?: boolean;
}
const { hide, share = false, audio = false } = Astro.props;

const links = [
  { key: "people", href: "people", label: "The people of this day", curtain: "The People" },
  { key: "paintings", href: "paintings", label: "The paintings", curtain: "The Paintings" },
  { key: "about", href: "about", label: "About the memorial", curtain: "About" },
  { key: "map", href: "map", label: "Map", curtain: "Map" },
].filter((l) => l.key !== hide);
---

<footer class="site-footer sec">
  <div class="rule-bleed"></div>
  {/* v7 F1 — the reference pattern on museum/memorial footers (docs/v7/AUDIT.md
      §4): a content grid, ONE full-width hairline, then a small muted meta row.
      Desktop: wordmark block · nav as a plain vertical list · Share (chapters).
      Phones stack wordmark → nav → Share → rule → disclaimer, one column, so no
      link ever wraps mid-label. One element carries weight (the name, in
      Caslon Display, one line); everything else is one small size. */}
  <div class="shell footer-grid">
    <div class="footer-mark">
      <p class="footer-wordmark">Charles Nalle Walking&nbsp;Memorial</p>
      <p class="t-meta-body mt-2"
        >Made by <a
          href="https://makeitnotable.com"
          class="inline-block py-1 underline underline-offset-4 transition-opacity hover:opacity-70"
          style="transition-duration: var(--dur-fast)"
          data-no-curtain>Notable</a
        ></p
      >
    </div>

    <nav class="footer-nav" aria-label="Elsewhere on the memorial">
      <ul class="flex flex-col gap-3">
        {
          links.map((l) => (
            <li>
              <a href={withBase(l.href)} data-curtain-label={l.curtain} class="link-meta t-meta w-fit py-1">
                {l.label}
                <Icon name="arrow" size="sm" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {share && (
      <div class="footer-share">
        <Button size="sm" variant="ghost" icon="share" id="share-btn">Share</Button>
      </div>
    )}
  </div>

  {/* Disclaimer — requested at the final review (2026-08-07): in the footer
      "so it's available at all times," on every page. Wording per Brian
      Clyne's 8/7 email (general no-responsibility form) plus the call's
      routes-are-suggestions intent. On chapters the row keeps the bottom-left
      lane clear for the narration mini-player (C10). */}
  <div class="shell footer-meta rule-top" data-audio={audio ? "true" : undefined}>
    <p class="t-meta-body footer-disclaimer">
      Walking routes and directions are suggestions only. Explore at your own pace,
      discretion, and&nbsp;risk.
    </p>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) auto;
      align-items: start;
      gap: 2.5rem;
    }
    .footer-share {
      justify-self: end;
    }
  }
  /* The name is the one element that carries weight: Caslon Display, one line,
     cream, sized so it never wraps at 320 and never shouts at 1920. */
  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.125rem, 0.9rem + 1.05vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-neutral-12);
    white-space: nowrap;
  }
  .footer-meta {
    margin-top: 0;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
  }
  /* Chapters keep the bottom-left lane clear for the narration pill (C10);
     the scoped rule used to out-cascade the `pb-28` utility. */
  .footer-meta[data-audio] {
    padding-bottom: 8rem;
  }
  .footer-disclaimer {
    max-width: 62ch;
    color: var(--ink-quiet);
  }
</style>
