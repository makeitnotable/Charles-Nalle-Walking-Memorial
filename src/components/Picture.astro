---
import { picture } from "../lib/media";

interface Props {
  slug: string;
  imageKey: string;
  alt: string;
  sizes?: string;
  class?: string;
  /** Inline style forwarded to the <img> (v7: real aspect-ratio tiles). */
  style?: string;
  loading?: "lazy" | "eager";
  /** Srcset ladder. Thumbnail slots should pass a small one — see lib/media.ts. */
  widths?: number[];
}

const {
  slug,
  imageKey,
  alt,
  sizes = "(min-width: 768px) 42rem, 100vw",
  class: className,
  style,
  loading = "lazy",
  widths,
} = Astro.props;
const p = picture(slug, imageKey, widths);
---

<picture>
  <source type="image/avif" srcset={p.avif} sizes={sizes} />
  <source type="image/webp" srcset={p.webp} sizes={sizes} />
  <img
    src={p.fallback}
    alt={alt}
    sizes={sizes}
    loading={loading}
    decoding="async"
    class={className}
    style={style}
  />
</picture>
