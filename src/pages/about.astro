---
/**
 * About — the reading page, and the second home of the cream register.
 * v3 held a ~670px measure at every width from 768 up, so 42% of a desktop
 * screen sat empty while the heading wrapped worse than it did on a tablet.
 * v4 puts the long text on the label-left editorial grid and moves the
 * project narrative onto the cream ground, where serif prose belongs.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { about } from "../data/about";
import { withBase } from "../lib/url";

const people = [
  { ...about.charles, image: "about-charles" },
  { ...about.mark, image: "about-mark" },
  { ...about.scott, image: "about-scott" },
];
---

<Base
  title="About — Charles Nalle Walking Memorial"
  description="About the Charles Nalle Walking Memorial: the people behind the project, the paintings of Mark Priest, and the scholarship of Scott Christianson."
>
  <header class="shell page-open">
    <p class="t-meta">{about.project.kicker}</p>
    <h1 class="t-display lines mt-8" style={`--fit-chars: ${Math.max(...about.project.header.split("\n").map((l) => l.trim().length))}`}>
      {about.project.header}
    </h1>
  </header>

  {/* The project narrative, on the reading ground. */}
  <section class="sec" aria-label="Project overview">
    <div class="ground-cream py-20 md:py-28">
      <div class="shell">
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">(01)</p>
            <p class="t-meta mt-3">The project</p>
          </div>
          <div class="space-y-6">
            {about.project.paragraphs.map((p) => <p class="t-prose reveal">{p}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell sec" aria-labelledby="how-heading">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">(02)</p>
        <p class="t-meta mt-3">How it works</p>
      </div>
      <div>
        <h2 id="how-heading" class="t-title reveal">{about.howItWorks.header}</h2>
        <ol class="reveal mt-14 space-y-10">
          {
            about.howItWorks.steps.map((step, i) => (
              <li class="grid grid-cols-[3.5rem_1fr] items-baseline">
                <span class="t-meta">({i + 1})</span>
                <div class="t-prose">
                  {step.title}
                  {"bullets" in step && step.bullets && (
                    <ul class="mt-3 list-disc space-y-1 pl-6 opacity-90">
                      {step.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    people.map((person, i) => (
      <section class="shell sec" aria-label={person.header}>
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">({String(i + 3).padStart(2, "0")})</p>
            <p class="t-meta mt-3">{person.kicker}</p>
          </div>
          <div>
            <h2 class="t-title reveal">{person.header}</h2>
            {/* These three files are 250×251 — `-800` and `-1440` are the same
                bytes under different names, so the old srcset was advertising
                resolutions that do not exist and the browser was painting a
                250px thumbnail at 828px CSS. It renders at its real size now,
                set beside the prose instead of stretched above it. */}
            <div class="mt-12 flex flex-col gap-10 sm:flex-row sm:items-start sm:gap-12">
              <img
                src={withBase(`media/site/${person.image}-800.webp`)}
                width="250"
                height="251"
                alt={person.header}
                loading="lazy"
                class="artifact reveal w-[168px] flex-none sm:w-[250px]"
              />
              <div class="space-y-6">
                {person.paragraphs.map((p) => (
                  <p class="t-prose reveal">{p}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="void">
    <div class="shell">
      <figure class="reveal-quote mx-auto max-w-[46rem]">
        <blockquote
          class="t-quote is-hung"
          style="--fs-quote: clamp(22px, 2.2vw, 30px); max-width: none"
        >
          “{about.closingQuote.text}”
        </blockquote>
        <figcaption class="t-meta mt-10">
          — {about.closingQuote.attribution}, {about.closingQuote.source}
        </figcaption>
      </figure>
    </div>
  </section>

  {/* No dead ends. */}
  <section class="shell sec">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">({String(people.length + 3).padStart(2, "0")})</p>
        <p class="t-meta mt-3">Onward</p>
      </div>
      <div>
        <p class="t-meta">The streets are waiting</p>
        <h2 class="t-title reveal mt-4">Walk the route</h2>
        <div class="mt-10">
          <a href={withBase("map")} data-curtain-label="Map" class="btn btn-solid">
            Walk the five spots
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter hide="about" />

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal, .reveal-quote, .lines").forEach((el) => io.observe(el));
  </script>
</Base>
