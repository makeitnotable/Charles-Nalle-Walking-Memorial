---
/**
 * About — the reading page, and the second home of the cream register.
 * v3 held a ~670px measure at every width from 768 up, so 42% of a desktop
 * screen sat empty while the heading wrapped worse than it did on a tablet.
 * v4 puts the long text on the label-left editorial grid and moves the
 * project narrative onto the cream ground, where serif prose belongs.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { about } from "../data/about";
import { withBase } from "../lib/url";
import { nbsp } from "../lib/text";
import route from "../data/route.json";

/* v7 A2: the walk's size, computed exactly as map.astro does — never hardcoded. */
const MILES = (route.distanceMeters / 1609.34).toFixed(1);
const MINUTES = Math.round(route.durationSeconds / 60 / 5) * 5;
const milesWords = MILES === "2.5" ? "Two and a half miles" : `${MILES} miles`;

const people = [
  { ...about.charles, image: "about-charles" },
  { ...about.mark, image: "about-mark" },
  { ...about.scott, image: "about-scott" },
];

/* v8 V8-304 (Wil, 8/19 00:52:21): the afterword attribution breaks after the
   book's short title, so the subtitle reads as its own line instead of
   wrapping mid-phrase. Wil asked on tablet; measured, the one-liner ALSO
   overruns the 46rem figure at 1024–1440 (an unauthored wrap mid-subtitle),
   so the break is authored at every width — noted in the review guide.
   Split here, never hardcoded — the data owns the title. */
const [QUOTE_BOOK, QUOTE_SUBTITLE] = about.closingQuote.source.split(": ");
---

<Base
  title="About · Charles Nalle Walking Memorial"
  description="About the Charles Nalle Walking Memorial: the people behind the project, the paintings of Mark Priest, and the scholarship of Scott Christianson."
>
  <header class="shell page-open">
    <p class="t-meta">{about.project.kicker}</p>
    <h1 class="t-display lines mt-8" style={`--fit-chars: ${Math.max(...about.project.header.split("\n").map((l) => l.trim().length))}`}>
      {about.project.header}
    </h1>
  </header>

  {/* The project narrative, on the reading ground. */}
  <section class="sec" aria-label="Project overview">
    <div class="ground-cream py-20 md:py-28">
      <div class="shell">
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">(01)</p>
            <p class="t-meta mt-3">The project</p>
          </div>
          <div class="space-y-6">
            {about.project.paragraphs.map((p) => <p class="t-prose reveal">{p}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell sec" aria-labelledby="how-heading">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">(02)</p>
        <p class="t-meta mt-3">{about.howItWorks.kicker}</p>
      </div>
      <div>
        <h2 id="how-heading" class="t-title reveal">{about.howItWorks.header}</h2>
        <ol class="reveal mt-14 space-y-10">
          {
            about.howItWorks.steps.map((step, i) => (
              <li class="grid grid-cols-[3.5rem_1fr] items-baseline">
                <span class="t-meta">({i + 1})</span>
                <div class="t-prose">
                  {nbsp(step.title)}
                  {"bullets" in step && step.bullets && (
                    <ul class="mt-3 list-disc space-y-1 pl-6 opacity-90">
                      {step.bullets.map((b) => (
                        <li>{nbsp(b)}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    people.map((person, i) => (
      <section class="shell sec" aria-label={person.header}>
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">({String(i + 3).padStart(2, "0")})</p>
            <p class="t-meta mt-3">{person.kicker}</p>
          </div>
          {/* v8 V8-305 (Wil, 8/19 01:18:34): on phones the NAME reads under the
              photograph with air above and below; from sm the name returns to
              the top of the block. Grid areas move only the paint — the DOM
              stays heading-first for screen readers. */}
          <div class="person-grid">
            <h2 class="t-title reveal person-name">{person.header}</h2>
            {/* These three files are 250×251 — `-800` and `-1440` are the same
                bytes under different names, so the old srcset was advertising
                resolutions that do not exist and the browser was painting a
                250px thumbnail at 828px CSS. It renders at its real size now,
                set beside the prose instead of stretched above it. */}
            <img
              src={withBase(`media/site/${person.image}-800.webp`)}
              width="250"
              height="251"
              alt={person.header}
              loading="lazy"
              class="artifact reveal person-photo w-[168px] sm:w-[250px]"
            />
            <div class="person-prose space-y-6">
              {person.paragraphs.map((p) => (
                <p class="t-prose reveal">{p}</p>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* v7 A1: the closing quote is a numbered section at one section gap, not a
      void after the portraits (Wil: too much space); the attribution stands
      without its dash. */}
  <section class="shell sec" aria-label="Afterword">
    <div class="sec-head"></div>
    <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">({String(people.length + 3).padStart(2, "0")})</p>
        <p class="t-meta mt-3">Afterword</p>
      </div>
      <figure class="reveal-quote max-w-[46rem]">
        <blockquote
          class="t-quote t-quote-long is-hung"
          style="--fs-quote: clamp(22px, 2.2vw, 30px); max-width: none"
        >
          “{nbsp(about.closingQuote.text)}”
        </blockquote>
        <figcaption class="t-meta mt-10">
          {about.closingQuote.attribution}, {QUOTE_BOOK}:{" "}
          <br />{nbsp(QUOTE_SUBTITLE)}
        </figcaption>
      </figure>
    </div>
  </section>

  {/* No dead ends. */}
  <section class="shell sec">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">({String(people.length + 4).padStart(2, "0")})</p>
        <p class="t-meta mt-3">Onward</p>
      </div>
      <div>
        <p class="t-meta">The streets are waiting</p>
        <h2 class="t-title reveal mt-4">{milesWords}. One day in&nbsp;1860.</h2>
        <p class="t-prose reveal mt-8 max-w-[52ch]">
          Four bronze plaques mark the route through downtown Troy; the fifth
          location, the Ferry Landing, is remembered here on the website. Start at
          any plaque, or begin from the map. About {MINUTES === 45 ? "forty-five" : MINUTES} minutes on&nbsp;foot.
        </p>
        {/* v8 V8-307 (Wil, 8/19 01:20:08): the closer centres on phones and
            tablets — About only; the People closer keeps its left seat. */}
        <div class="mt-10 flex justify-center lg:justify-start">
          <a href={withBase("map")} data-curtain-label="Map" class="btn btn-solid btn-icon-end">
            Walk the story
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter hide="about" />

  <style>
    /* V8-305: phones read photo → name → prose; sm+ restores name on top with
       the photo+prose row under it (the v7 layout, unchanged measurements). */
    .person-grid {
      display: grid;
      grid-template-areas: "photo" "name" "prose";
    }
    .person-name {
      grid-area: name;
      margin-top: 2rem;
    }
    .person-photo {
      grid-area: photo;
    }
    .person-prose {
      grid-area: prose;
      margin-top: 1.75rem;
    }
    @media (min-width: 640px) {
      .person-grid {
        grid-template-areas: "name name" "photo prose";
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 3rem;
        align-items: start;
      }
      .person-name {
        margin-top: 0;
      }
      .person-photo,
      .person-prose {
        margin-top: 3rem;
      }
    }
  </style>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal, .reveal-quote, .lines").forEach((el) => io.observe(el));
  </script>
</Base>
