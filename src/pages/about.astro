---
import Base from "../layouts/Base.astro";
import { about } from "../data/about";

const people = [about.charles, about.mark, about.scott];
---

<Base
  title="About — Charles Nalle Walking Memorial"
  description="About the Charles Nalle Walking Memorial: the people behind the project, the paintings of Mark Priest, and the scholarship of Scott Christianson."
>
  <article class="mx-auto max-w-2xl px-6 pb-16">
    <header class="pt-16 pb-10">
      <p class="text-sm uppercase tracking-[0.25em] opacity-70">{about.project.kicker}</p>
      <h1 class="font-display mt-4 text-4xl sm:text-5xl">{about.project.header}</h1>
    </header>

    <section aria-label="Project overview">
      {about.project.paragraphs.map((p) => <p class="mt-5 leading-relaxed">{p}</p>)}
    </section>

    <section class="mt-16" aria-labelledby="how-heading">
      <h2 id="how-heading" class="font-display text-3xl">{about.howItWorks.header}</h2>
      <ol class="mt-6 list-decimal space-y-4 pl-5">
        {
          about.howItWorks.steps.map((step) => (
            <li class="leading-relaxed">
              {step.title}
              {"bullets" in step && step.bullets && (
                <ul class="mt-2 list-disc space-y-1 pl-5 opacity-90">
                  {step.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    {
      people.map((person) => (
        <section class="mt-16" aria-label={person.header}>
          <p class="text-xs uppercase tracking-widest opacity-60">{person.kicker}</p>
          <h2 class="font-display mt-2 text-3xl">{person.header}</h2>
          {person.paragraphs.map((p) => (
            <p class="mt-5 leading-relaxed">{p}</p>
          ))}
        </section>
      ))
    }

    <figure class="mt-16 border-l-4 pl-4" style="border-color: var(--chapter-accent)">
      <blockquote class="font-display text-xl italic leading-relaxed">
        “{about.closingQuote.text}”
      </blockquote>
      <figcaption class="mt-3 text-sm opacity-70">
        — {about.closingQuote.attribution}, {about.closingQuote.source}
      </figcaption>
    </figure>
  </article>
</Base>
