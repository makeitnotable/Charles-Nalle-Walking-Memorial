---
// The Walk — approved map experience (signature #4) + the typographic
// all-stops index below it (blueprint gap 7: the index IS the keyboard and
// screen-reader path through the walk, and the no-JS state).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TroyMap from "../components/TroyMap";
import Picture from "../components/Picture.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";
import { fitChars } from "../lib/text";
import route from "../data/route.json";
const MAP_HEADING = "Five spots<br />through Troy";

const chapters = (await getCollection("chapters")).sort(
  (a, b) => a.data.order - b.data.order,
);

const stops = chapters.map((entry) => ({
  slug: entry.id,
  order: entry.data.order,
  label: entry.data.name.short,
  canonical: entry.data.name.canonical,
  cardTitle: entry.data.name.canonical,
  pinOffset: entry.data.pinOffset,
  address: entry.data.map.address,
  coordinates: entry.data.map.coordinates,
  plaque: entry.data.plaque,
}));

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{/* Item 9: no WalkProgress rail here — the map IS the walk's overview; a
    second progress instrument above it was chrome noise. Item 10's menu
    lane: bottom-right, clear of the map's own top chrome. */}
<Base
  title="Map — Charles Nalle Walking Memorial"
  description="The route of the Charles Nalle rescue through downtown Troy, NY: five spots from the bakery where he was seized to the barbershop where his freedom was won."
  menuPosition="bottom-right"
>

  {/* The shell is server-rendered at full height so island hydration causes
      zero layout shift; the island fills it. */}
  <div class="map-shell">
    <div id="map-placeholder" class="absolute inset-0 grid place-items-center" aria-hidden="true">
      <p class="t-meta">The map is loading…</p>
    </div>
    <TroyMap client:only="react" stops={stops} baseUrl={baseUrl} />
  </div>

  {/* The typographic index — wayfinding for everyone, the whole page for no-JS */}
  <section class="shell sec" aria-label="The five spots">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">(01)</p>
        <p class="t-meta mt-3">The map</p>
      </div>
      <div>
        <h1 class="t-display reveal" style={fitChars(MAP_HEADING)} set:html={MAP_HEADING} />
        <p class="t-prose reveal mt-10">
          The rescue of Charles Nalle unfolded across a few blocks of downtown
          Troy in a single day — April 27, 1860. Four spots carry bronze
          plaques; the Ferry Landing is remembered here on the website.
        </p>
        {/* The walk has a size, and saying it is the difference between a map
            and an invitation. Both numbers come from the same Directions
            geometry the route is drawn from. */}
        <p class="t-meta reveal mt-8">
          {(route.distanceMeters / 1609.34).toFixed(1)} miles · about{" "}
          {Math.round(route.durationSeconds / 60 / 5) * 5} minutes on foot
        </p>
      </div>
    </div>

    {/* The typographic index — the image IS the card; nothing is boxed. */}
    <ol class="beat">
      {
        chapters.map((entry) => (
          <li class="reveal rule-top">
            <a
              href={withBase(entry.id)}
              data-curtain-label={entry.data.name.short}
              data-curtain-date
              class="group grid grid-cols-[5rem_1fr_auto] items-center gap-5 py-6 sm:grid-cols-[7rem_1fr_auto] sm:gap-8"
            >
              {/* The archival record of the place, not the painting: the map
                  carousel already shows every stop's `square` painting crop, so
                  this index was the second copy of all five. A photograph of the
                  building is also the more useful thing when the index is being
                  used for what it is — finding a door on a street. */}
              <span class="overflow-hidden rounded-[12px]">
                {/* 112 CSS px at the largest. With only 800/1440 offered the
                    browser had to take the 800 for every row — five of them,
                    ~250 KB, competing with the map's own load. */}
                <Picture
                  slug={entry.id}
                  imageKey="historical"
                  alt=""
                  sizes="7rem"
                  widths={[400, 800]}
                  class="h-20 w-20 object-cover transition-transform duration-300 group-hover:scale-105 sm:h-28 sm:w-28"
                />
              </span>
              <span class="min-w-0">
                <span class="t-meta block">Spot {String(entry.data.order).padStart(2, "0")}</span>
                <span class="t-title-sm mt-3 block">
                  {entry.data.name.canonical}
                </span>
                <span class="t-meta-body mt-3 block">
                  {entry.data.map.address}
                  {!entry.data.plaque && " · no plaque — website only"}
                </span>
              </span>
              <Icon name="arrow" class="text-primary-11 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <SiteFooter hide="map" />

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
