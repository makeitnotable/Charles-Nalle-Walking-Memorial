---
// The Walk — approved map experience (signature #4) + the typographic
// all-stops index below it (blueprint gap 7: the index IS the keyboard and
// screen-reader path through the walk, and the no-JS state).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TroyMap from "../components/TroyMap";
import Picture from "../components/Picture.astro";
import { withBase } from "../lib/url";

const chapters = (await getCollection("chapters")).sort(
  (a, b) => a.data.order - b.data.order,
);

const stops = chapters.map((entry) => ({
  slug: entry.id,
  order: entry.data.order,
  label: entry.data.map.label,
  cardTitle: entry.data.cardTitle,
  address: entry.data.map.address,
  coordinates: entry.data.map.coordinates,
  plaque: entry.data.plaque,
}));

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="The Walk — Charles Nalle Walking Memorial"
  description="The route of the Charles Nalle rescue through downtown Troy, NY: five stops from the bakery where he was seized to the barbershop where his freedom was won."
  menuPosition="bottom-right"
>
  {/* The shell is server-rendered at full height so island hydration causes
      zero layout shift; the island fills it. */}
  <div class="map-shell">
    <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
      <p class="type-label">The walk is loading…</p>
    </div>
    <TroyMap client:only="react" stops={stops} baseUrl={baseUrl} />
  </div>

  {/* The typographic index — wayfinding for everyone, the whole page for no-JS */}
  <section class="mx-auto max-w-7xl px-4 pt-16 pb-8 md:px-10 lg:px-20" aria-label="The five stops">
    <p class="type-label reveal">The Walk</p>
    <h1 class="type-display type-display-caps reveal mt-4">
      Five stops<br />through Troy
    </h1>
    <p class="type-body reveal mt-6 max-w-xl">
      The rescue of Charles Nalle unfolded across a few blocks of downtown Troy
      in a single day — April 27, 1860. Four stops carry bronze plaques; the
      Ferry Landing is remembered here on the website.
    </p>

    <ol class="mt-12 space-y-6">
      {
        chapters.map((entry) => (
          <li class="reveal">
            <a
              href={withBase(entry.id)}
              data-curtain-label={entry.data.map.label}
              data-curtain-date
              class="frame group grid grid-cols-[6rem_1fr] items-center gap-0 overflow-hidden bg-primary-3 transition-colors duration-300 hover:bg-primary-4 sm:grid-cols-[8rem_1fr]"
            >
              <Picture
                slug={entry.id}
                imageKey="square"
                alt=""
                sizes="8rem"
                class="h-24 w-24 border-r border-primary-6 object-cover sm:h-32 sm:w-32"
              />
              <span class="min-w-0 p-4 sm:p-5">
                <span class="flex items-center justify-between">
                  <span class="type-label">Chapter</span>
                  <span class="flex h-4 w-4 items-center justify-center rounded-full bg-primary-10 sm:h-5 sm:w-5">
                    <span
                      class="mt-0.5 text-[.625rem] font-medium text-primary-12 sm:text-[0.78125rem]"
                      style="font-family: var(--font-poppins)"
                    >
                      {entry.data.order}
                    </span>
                  </span>
                </span>
                <span class="type-card-title mt-1 block uppercase">
                  {entry.data.cardTitle}
                </span>
                <span class="type-muted mt-1 block">
                  {entry.data.map.address}
                  {!entry.data.plaque && " · no plaque — website only"}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
