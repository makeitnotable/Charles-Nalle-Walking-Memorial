---
/**
 * THE CHAPTER TEMPLATE — the flagship.
 *
 * Structure (docs/PLAN.md §8):
 *   Hero — the finished ANIMATED PAINTING, poster-first, in the signature frame
 *   (01…) The story — scene quote alone in a void → narration object → cream transcript
 *   (0N)  From the sketch — the press-and-hold, relocated here as the process beat
 *          followed by the full-bleed painting interlude
 *   (0N)  Historical context — label-left / prose-right, hanging numerals
 *   (0N)  The moral — full-bleed, one artifact
 *   (0N)  Onward — framed map, destination lockup, ONE button pair
 *   Footer band
 *
 * What changed from v3 and why:
 *  · The hero was the black-and-white SKETCH. It is now the animated painting;
 *    the sketch interaction moved to its own section (W7).
 *  · The hero ran 1344px against a 1280px shell — a visible registration error.
 *    Everything now sits in `.shell` (W5).
 *  · Four different section gaps became one token; "Section N/4" became a
 *    numbered editorial spine carried in each section's left rail (W4).
 *  · The historical <video> carried TWO class attributes, so the second silently
 *    dropped `lazy-video` and that video never hydrated. Fixed below.
 *  · Every displayed name now derives from `name.{canonical,display,short}` (W6).
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import PressReveal from "../components/PressReveal";
import AudioStory from "../components/AudioStory";
import EmbedMap from "../components/EmbedMap";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((entry) => ({ params: { chapter: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;
const slug = entry.id;

const all = await getCollection("chapters");
const nextEntry = all.find((e) => e.id === c.next.slug);
const nextName = nextEntry?.data.name;

// Per-chapter embedded map cameras (legacy MAP_CONFIG.locationPage)
const cameras: Record<number, { pitch: number; bearing: number; zoom: number }> = {
  1: { pitch: 45, bearing: 45, zoom: 17 },
  2: { pitch: 48, bearing: 75, zoom: 17.8 },
  3: { pitch: 45, bearing: 45, zoom: 15.5 },
  4: { pitch: 45, bearing: 55, zoom: 17.3 },
  5: { pitch: 48, bearing: 55, zoom: 17.5 },
};
const camera = cameras[c.order] ?? { pitch: 33, bearing: 10, zoom: 15.25 };

const hasHistoricalVideo = c.media.videos.includes("historical");
const moral = c.morals[0];
const pad2 = (n: number) => String(n).padStart(2, "0");

/**
 * The editorial spine, built from the data so the numbering can never drift
 * from what actually renders (chapter 2 has two scenes and therefore two
 * listening sections).
 */
type Sec = { key: string; rail: string; sceneIndex?: number };
const sections: Sec[] = [];
c.scenes.forEach((_, i) => {
  sections.push({
    key: `scene-${i}`,
    rail: c.scenes.length > 1 ? `Listen · Pt ${i + 1}` : "Listen",
    sceneIndex: i,
  });
});
sections.push({ key: "sketch", rail: "The sketch" });
sections.push({ key: "history", rail: "History" });
if (moral) sections.push({ key: "moral", rail: "The moral" });
sections.push({ key: "onward", rail: "Onward" });
const num = (key: string) => pad2(sections.findIndex((s) => s.key === key) + 1);

/** Longest authored line in a display string — drives the fit-clamp. */
const longestLine = (t: string) => Math.max(...t.split("\n").map((l) => l.trim().length));

/* The hero's first paint is its poster, so the poster IS the LCP. It is
 * rendered as a real responsive <img> beneath the film (a <video poster>
 * attribute takes a single URL and cannot be art-directed or served as AVIF).
 * Filenames are new — GitHub Pages caches hard, so reusing them would serve
 * the old 146KB JPEGs. See scripts/build-posters.mjs. */
const hKey = c.scenes[0].reveal?.video ?? "reveal-horizontal";
const vKey = c.scenes[0].reveal?.videoVertical ?? "reveal-vertical";
const poster = (key: string, ext: string) => withBase(`media/${slug}/${key}-poster-800.${ext}`);
const heroAlt = `“${c.name.canonical}” — painting by Mark Priest`;
---

<Base
  title={`${c.name.canonical} — Charles Nalle Walking Memorial`}
  description={`${c.chapterLabel} of the Charles Nalle Walking Memorial: ${c.name.canonical}, Troy, NY, April 27, 1860.`}
  menuPosition="bottom-right"
  preloadImages={[
    { href: poster(vKey, "avif"), type: "image/avif", media: "(max-width: 767px)" },
    { href: poster(hKey, "avif"), type: "image/avif", media: "(min-width: 768px)" },
  ]}
>
  {/* ══════ HERO — the finished animated painting ══════ */}
  <header id="hero" class="shell flex min-h-dvh flex-col pt-20 pb-6 md:pt-24">
    <div id="hero-lockup" class="flex-none">
      <p class="t-meta">
        Stop {pad2(c.order)} of 5 · Troy, NY · April 27, 1860
      </p>
      <p class="t-spine mt-[max(4vh,32px)]">(CH. {pad2(c.order)})</p>
      <h1
        class="t-display lines mt-4 whitespace-pre-line"
        style={`--fit-chars: ${longestLine(c.name.display)}`}
      >
        {c.name.display}
      </h1>
      <div class="rule-top mt-8"></div>
    </div>

    <p class="t-meta mt-6 flex items-center gap-3 text-primary-11">
      <Icon name="headphones" size="sm" /> Scroll to listen
      <Icon name="arrow" rotate={90} size="sm" class="hero-cue" />
    </p>

    <div
      id="hero-media"
      class="artifact-lg relative mt-8 min-h-[42dvh] flex-1 bg-neutral-2 md:min-h-[46dvh]"
    >
      {/* The still painting — the LCP, responsive and art-directed. */}
      <picture>
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={poster(vKey, "avif")}
        />
        <source media="(max-width: 767px)" type="image/webp" srcset={poster(vKey, "webp")} />
        <source type="image/avif" srcset={poster(hKey, "avif")} />
        <source type="image/webp" srcset={poster(hKey, "webp")} />
        <img
          src={withBase(`media/${slug}/${hKey}-poster.jpg`)}
          alt={heroAlt}
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>

      {/* The film arrives over it after window load — never under reduced
          motion, where the painting simply stays still. */}
      <video
        class="lazy-video absolute inset-0 hidden h-full w-full object-cover md:block"
        data-src={withBase(`media/${slug}/${hKey}.mp4`)}
        data-reduce-static
        preload="none"
        loop
        muted
        playsinline
        aria-hidden="true"></video>
      <video
        class="lazy-video absolute inset-0 h-full w-full object-cover md:hidden"
        data-src={withBase(`media/${slug}/${vKey}.mp4`)}
        data-reduce-static
        preload="none"
        loop
        muted
        playsinline
        aria-hidden="true"></video>
    </div>
  </header>

  {/* ══════ THE STORY — one section per scene ══════ */}
  {
    c.scenes.map((scene, i) => (
      <section class="shell sec" id={`scene-${i}`} aria-label={scene.label}>
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">({num(`scene-${i}`)})</p>
            <p class="t-meta mt-3">{sections.find((s) => s.key === `scene-${i}`)?.rail}</p>
          </div>

          <div>
            <h2 class="t-title reveal">{scene.label}</h2>

            {scene.quote && (
              <figure class="reveal-quote beat">
                <blockquote class="t-quote is-hung">“{scene.quote.text}”</blockquote>
                <figcaption class="t-meta mt-6">— {scene.quote.attribution}</figcaption>
              </figure>
            )}

            <div class="beat">
              <AudioStory
                client:visible
                slug={slug}
                audioSrc={withBase(scene.audio.file)}
                label={scene.audio.label}
                subtitle={c.name.canonical}
                duration={scene.audio.duration}
                timings={scene.audio.timings}
                paragraphs={scene.paragraphs}
              />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* ══════ FROM THE SKETCH — the artist's-process beat ══════ */}
  {
    c.scenes[0].reveal && (
      <section class="shell sec" id="sketch" aria-labelledby="sketch-heading">
        <div class="sec-head" />
        <div class="mt-8 grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
          <div>
            <p class="t-spine">({num("sketch")})</p>
            <p class="t-meta mt-3">The sketch</p>
            <h2 id="sketch-heading" class="t-title reveal mt-8">
              From the
              <br />
              sketch
            </h2>
            <p class="t-prose reveal mt-8">
              Every painting in this memorial began as a pencil study. Mark Priest
              worked the crowd out in graphite first — the gestures, the weight of
              a body pulling against a grip — before any colour was mixed.
            </p>
            <p class="t-prose reveal mt-6">
              Press and hold the study to let the finished painting develop under
              your hand.
            </p>
          </div>

          <div class="reveal artifact self-start">
            <PressReveal
              client:visible
              slug={slug}
              sketch={c.scenes[0].reveal.sketch}
              video={c.scenes[0].reveal.video}
              videoVertical={c.scenes[0].reveal.videoVertical}
              painting={c.scenes[0].reveal.painting}
              alt={`“${c.name.canonical}” — painting by Mark Priest`}
            />
          </div>
        </div>
      </section>
    )
  }

  {/* ══════ The painting narrates — full-bleed interlude, zero chrome ══════ */}
  <section
    class="painting-interlude sec relative overflow-hidden"
    aria-label={`Painting — ${c.name.canonical}, by Mark Priest`}
  >
    <img
      class="interlude-img h-[58vh] w-full object-cover md:h-[78vh]"
      src={withBase(`media/${slug}/horizontal-1440.jpg`)}
      srcset={`${withBase(`media/${slug}/horizontal-800.webp`)} 800w, ${withBase(`media/${slug}/horizontal-1440.webp`)} 1440w`}
      sizes="100vw"
      alt={`“${c.name.canonical}” — painting by Mark Priest`}
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, var(--color-primary-2), transparent 20%, transparent 80%, var(--color-primary-2))"
    >
    </div>
    <p class="t-meta absolute right-[var(--gutter)] bottom-8">Mark Priest · Nalle Series</p>
  </section>

  {/* ══════ HISTORICAL CONTEXT ══════ */}
  <section class="sec" id="history" aria-labelledby="history-heading">
   <div class="ground-cream py-24 md:py-32">
    <div class="shell">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">({num("history")})</p>
        <p class="t-meta mt-3">History</p>
      </div>

      <div>
        <h2 id="history-heading" class="t-title reveal">Historical<br />context</h2>

        <div class="reveal artifact mt-12">
          {
            hasHistoricalVideo ? (
              <video
                class="lazy-video h-auto w-full"
                data-src={withBase(`media/${slug}/historical.mp4`)}
                data-poster={withBase(`media/${slug}/historical-poster.jpg`)}
                preload="none"
                loop
                muted
                playsinline
                aria-label={`Archival film — ${c.name.canonical}`}
              />
            ) : (
              <Picture
                slug={slug}
                imageKey="historical"
                alt={`Historical photograph — ${c.name.canonical}`}
                class="h-auto w-full"
              />
            )
          }
        </div>

        {/* Facts on a fixed numeral column — the orange chips are gone. */}
        <dl class="reveal mt-16 space-y-8">
          {
            c.historicalContext.map((point, index) => (
              <div class="grid grid-cols-[3.5rem_1fr] items-baseline">
                <dt class="t-meta">({index + 1})</dt>
                <dd class="t-prose">{point}</dd>
              </div>
            ))
          }
        </dl>

        {
          c.portal.history.length > 0 && (
            <div class="reveal mt-16 space-y-6">
              {c.portal.history.map((p) => (
                <p class="t-prose">{p}</p>
              ))}
            </div>
          )
        }
      </div>
    </div>
    </div>
   </div>
  </section>

  {/* ══════ THE MORAL — full-bleed, one artifact ══════ */}
  {
    moral && (
      <section class="void relative" id="moral" aria-labelledby="moral-heading">
        <div class="absolute inset-0" aria-hidden="true">
          <img
            src={withBase(`media/${slug}/moral-1440.jpg`)}
            alt=""
            class="h-full w-full object-cover"
            style="object-position: center 25%"
            loading="lazy"
          />
          <div class="absolute inset-0" style="background: linear-gradient(#1d1411, rgba(29,20,17,.72) 30%, rgba(29,20,17,.72) 70%, #1d1411)" />
        </div>

        <div class="shell relative z-10 py-32 md:py-40">
          <div class="sec-head"></div>
        <div class="editorial mt-8">
            <div class="rail">
              <p class="t-spine">({num("moral")})</p>
              <p class="t-meta mt-3">The moral</p>
            </div>
            <div>
              <h2
                id="moral-heading"
                class="t-display lines reveal whitespace-pre-line"
                style={`--fit-chars: ${longestLine(moral.title)}`}
              >
                {moral.title}
              </h2>
              <p class="t-prose reveal mt-12">{moral.message}</p>

              <div class="reveal mt-16 flex flex-col gap-10 md:flex-row md:items-start md:gap-12">
                <img
                  class="artifact h-[220px] w-[220px] flex-none object-cover lg:h-[300px] lg:w-[300px]"
                  style="object-position: center 22%"
                  src={withBase(`media/${slug}/moral-800.webp`)}
                  loading="lazy"
                  alt={`“${c.name.canonical}” — painting by Mark Priest`}
                />
                <div>
                  <p class="t-meta">{moral.callToAction.title}</p>
                  <p class="t-prose mt-4">{moral.callToAction.content}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ══════ ONWARD ══════ */}
  <section class="shell sec" id="onward" aria-label="Continue the walk">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">({num("onward")})</p>
        <p class="t-meta mt-3">Onward</p>
      </div>

      <div>
        <h2 class="t-title reveal">Where<br />to next</h2>

        {
          nextEntry && (
            <div class="reveal embed-map-shell artifact mt-12">
              <EmbedMap
                client:visible
                coordinates={nextEntry.data.map.coordinates as [number, number]}
                label={nextEntry.data.name.short}
                order={nextEntry.data.order}
                pitch={camera.pitch}
                bearing={camera.bearing}
                zoom={camera.zoom}
              />
            </div>
          )
        }

        {/* GA&C banner discipline: four elements, nothing else. */}
        <div class="reveal mt-12">
          <p class="t-meta">Next — Stop {pad2(nextEntry?.data.order ?? 1)}</p>
          <p class="t-title-sm mt-4">{nextName?.canonical}</p>
          <p class="t-meta-body mt-3">{nextEntry?.data.map.address}</p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <Button
              variant="solid"
              icon="arrow"
              href={withBase(c.next.slug)}
              data-curtain-label={nextName?.short}
              data-curtain-date
            >
              Continue the walk
            </Button>
            {
              nextEntry && (
                <Button
                  variant="ghost"
                  icon="arrow"
                  external
                  href={`https://www.google.com/maps/dir/?api=1&destination=${nextEntry.data.map.coordinates[1]},${nextEntry.data.map.coordinates[0]}&travelmode=walking`}
                >
                  Get directions
                </Button>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter hide={undefined} share />

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      // Hero: the framed painting grows toward full bleed and un-rounds as the
      // lockup rises away. Scale is capped at 1.15 — v3 ran 1.4 and pushed the
      // frame past the shell.
      const media = document.getElementById("hero-media");
      const lockup = document.getElementById("hero-lockup");
      if (media && lockup) {
        gsap
          .timeline({
            scrollTrigger: {
              trigger: media,
              start: "top top",
              end: "+=100%",
              scrub: 0.5,
              invalidateOnRefresh: false,
            },
          })
          .to(media, { scale: 1.15, borderRadius: 0 }, 0)
          .to(lockup, { y: -160, opacity: 0.25 }, 0);
      }

      // The painting interlude breathes as you pass it — Ken Burns scrub.
      const img = document.querySelector(".interlude-img");
      if (img) {
        gsap.fromTo(
          img,
          { scale: 1.1, yPercent: -3 },
          {
            scale: 1,
            yPercent: 3,
            ease: "none",
            scrollTrigger: {
              trigger: ".painting-interlude",
              start: "top bottom",
              end: "bottom top",
              scrub: 0.6,
            },
          },
        );
      }
    }

    // Scroll-reveal suite (house vocabulary; CSS owns the motion).
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );
    document.querySelectorAll(".reveal, .reveal-quote, .lines").forEach((el) => io.observe(el));

    // Share: native share sheet, clipboard fallback.
    document.getElementById("share-btn")?.addEventListener("click", async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else {
          await navigator.clipboard.writeText(location.href);
          const b = document.getElementById("share-btn");
          if (b) b.childNodes[b.childNodes.length - 1].textContent = "Link copied";
        }
      } catch {
        /* user dismissed */
      }
    });
  </script>
</Base>
