---
// Home — approved signature #6: full-viewport photo frame, three-stack
// (Troy, NY → interlocked wordmark → 1821—1875 rule), Continue pill, mission
// copy with hand-authored breaks. The v2 entry moment folds IN: the splash
// film plays inside the photo frame, the stack rises in sequence, the date
// rule draws itself. Reduced motion: static frame, everything visible.
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
---

<Base
  title="Charles Nalle Walking Memorial — Troy, NY"
  description="Walk the streets of Troy, New York, where on April 27, 1860 the people of the city — led by Harriet Tubman — rose up to free Charles Nalle from the Fugitive Slave Act."
>
  <div class="h-dvh p-4 md:p-12">
    <div class="relative flex h-full flex-col items-center justify-between">
      <!-- The photo frame: film plays inside it, treated like the approved still -->
      <div
        class="home-frame absolute inset-0 z-0 overflow-hidden rounded-[32px] border border-gray-7"
        aria-hidden="true"
      >
        <video
          class="h-full w-full object-cover motion-reduce:hidden"
          style="filter: grayscale(100%) brightness(0.7) contrast(1) sepia(0.1)"
          src={withBase("media/site/splash.mp4")}
          poster={withBase("media/site/home-bg-1440.jpg")}
          autoplay
          muted
          loop
          playsinline></video>
        <img
          class="hidden h-full w-full object-cover motion-reduce:block"
          style="filter: grayscale(100%) brightness(0.7) contrast(1) sepia(0.1)"
          src={withBase("media/site/home-bg-1440.jpg")}
          alt=""
        />
        <div class="absolute inset-0" style="background: var(--scrim-photo)"></div>
      </div>

      <!-- The three-stack -->
      <div class="z-10 flex h-full flex-col items-center justify-between">
        <div class="flex flex-col items-center justify-between gap-8 pt-16">
          <p class="type-eyebrow home-seq" style="--seq: 0">Troy, NY</p>
          <h1 class="flex flex-col" aria-label="Charles Nalle">
            <span class="type-wordmark home-seq" style="--seq: 1">Charles</span>
            <span class="type-wordmark home-seq self-end" style="--seq: 2; margin-top: -0.75rem">Nalle</span>
          </h1>
          <div class="home-seq flex items-center gap-2" style="--seq: 3">
            <p class="type-eyebrow">1821</p>
            <div class="rule-draw -mt-0.5 h-[1px] w-[28px] bg-primary-10"></div>
            <p class="type-eyebrow">1875</p>
          </div>
        </div>

        <div class="home-seq flex w-full justify-center px-4" style="--seq: 4">
          <a
            href={withBase("map")}
            class="flex w-[148px] cursor-pointer items-center justify-center rounded-full px-6 py-4 text-center text-[1.125rem] leading-[1.5rem] font-medium transition-all duration-300 hover:brightness-105 md:px-[1.875rem] md:py-[1.25rem] md:text-[1.40625rem] md:leading-[1.875rem] lg:px-[2.25rem] lg:py-[1.5rem] lg:text-[1.6875rem] lg:leading-[2.25rem]"
            style="background: var(--cta-bg); color: var(--cta-text); border: 1px solid var(--cta-border); font-family: var(--font-poppins)"
          >
            Continue
          </a>
        </div>

        <div class="home-seq flex flex-col items-center justify-between p-4" style="--seq: 5">
          {/* Mobile and tablet: hand breaks via measure */}
          <p class="type-muted mx-4 mb-2 block max-w-[283px] text-center md:max-w-[353px] lg:hidden">
            The Charles Nalle Walking Memorial is a digital physical experience
            designed to share the history of Troy and the story of Charles Nalle
          </p>
          {/* Desktop: break after "designed" */}
          <p class="type-muted mx-4 mb-2 hidden text-center lg:block">
            The Charles Nalle Walking Memorial is a digital physical experience designed<br />
            to share the history of Troy and the story of Charles Nalle
          </p>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Frame settles from black to the approved 50% presence */
  .home-frame {
    opacity: 0.5;
  }
  /* Entry choreography — staggered rise, rule draw. CSS-only so the no-JS
     and reduced-motion states are simply "everything visible". */
  .home-seq {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-frame {
      animation: frame-in 1400ms var(--ease-house) both;
    }
    @keyframes frame-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 0.5;
      }
    }
    .home-seq {
      animation: home-rise 900ms var(--ease-house) both;
      animation-delay: calc(300ms + var(--seq) * 160ms);
    }
    @keyframes home-rise {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .rule-draw {
      animation: rule-x 700ms var(--ease-house) both;
      animation-delay: calc(300ms + 3 * 160ms + 250ms);
      transform-origin: left center;
    }
    @keyframes rule-x {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
</style>
