---
/**
 * The Paintings — Mark Priest's Nalle Series.
 * v4: the image IS the card (Google Arts & Culture). No frame, no button
 * chrome — a flush image over a fixed eyebrow / title / credit micro-grid with
 * the same offsets on every tile, and hover scales the image inside its own
 * clip, never the card.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";
import { fitChars } from "../lib/text";
import Museum from "../components/Museum";
import sharp from "sharp";
import { readFile } from "node:fs/promises";
import { join } from "node:path";

/* v7 U8: every canvas hangs at its TRUE aspect — read once at build from the
   1440 asset (six are 16:9, three 3:2, Barbershop Narrative II is a 2:3
   portrait); the study's aspect likewise. Module-level cache; fallback 1.5. */
const aspectCache = new Map<string, number>();
const aspectOf = async (rel: string, fallback: number) => {
  if (aspectCache.has(rel)) return aspectCache.get(rel)!;
  let a = fallback;
  try {
    /* Resolved from the PROJECT ROOT (process.cwd() during `astro build`), never
       import.meta.url — under the production build the page module lives in a
       temp chunk and a module-relative path silently fell back to 1.5 (juror
       pass 1, P1). */
    const m = await sharp(await readFile(join(process.cwd(), "public", rel))).metadata();
    if (m.width && m.height) a = +(m.width / m.height).toFixed(4);
  } catch {
    /* keep the fallback */
  }
  aspectCache.set(rel, a);
  return a;
};
const PAINTINGS_HEADING = "THE NALLE<br />SERIES";

const chapters = (await getCollection("chapters")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Painting keys per chapter, in gallery order, with human titles. */
const KEY_TITLES: Record<string, string> = {
  horizontal: "",
  "horizontal-pt2": "Part\u00a02",
  narrative1: "Narrative\u00a0I",
  narrative2: "Narrative\u00a0II",
};
/* v8 V8-320 (Wil, 00:32:36): the HALL plaque names the barbershop pair
 * "Peter Baltimore's Barbershop 1 / 2" — the stills grid below keeps its
 * Narrative numbering at his direction (00:34:11). Per-chapter overrides so
 * the ferry narratives are untouched. */
const PLAQUE_VARIANTS: Record<string, Record<string, string>> = {
  barbershop: { narrative1: "1", narrative2: "2" },
};
/** Animated variant per painting key (elevation G2: the dialog plays the
 * painting alive where Mark Priest's animation exists). */
const KEY_VIDEOS: Record<string, string> = {
  horizontal: "reveal-horizontal",
  "horizontal-pt2": "reveal-horizontal-pt2",
  narrative1: "narrative1",
  narrative2: "narrative2",
};

const works = chapters.flatMap((entry) =>
  Object.keys(KEY_TITLES)
    .filter((key) => entry.data.media.images.includes(key))
    .map((key) => ({
      slug: entry.id,
      key,
      title: KEY_TITLES[key]
        ? `${entry.data.name.canonical} ·\u00a0${KEY_TITLES[key]}`
        : entry.data.name.canonical,
      chapterLabel: entry.data.chapterLabel,
      order: entry.data.order,
      full: withBase(`media/${entry.id}/${key}-1440.jpg`),
      video: entry.data.media.videos.includes(KEY_VIDEOS[key])
        ? withBase(`media/${entry.id}/${KEY_VIDEOS[key]}.mp4`)
        : null,
      href: withBase(entry.id),
      mapLabel: entry.data.name.short,
    })),
);

/** The museum's copy of the catalogue — texture URLs + the study beside the
 * chapter's main canvas. Every asset already exists in the media pipeline. */
const aspects = await Promise.all(works.map((w) => aspectOf(`media/${w.slug}/${w.key}-1440.jpg`, 1.5)));
const sketchAspects = await Promise.all(works.map((w) => aspectOf(`media/${w.slug}/sketch-800.webp`, 1.25)));
/* v8 V8-329 (Wil, 01:13:43): the plaque shows the study too. The main canvas
   takes its chapter's study; the commissioner's Part 2 has its own drawing on
   disk. Narrative works have none and simply omit the row. This is the
   PLAQUE's copy — the hall's `sketch` (which hangs a study on the wall beside
   the main canvas only) is deliberately left alone. */
const studyKeyOf = (key: string) =>
  key === "horizontal" ? "sketch" : key === "horizontal-pt2" ? "sketch-pt2" : null;
const studyAspects = await Promise.all(
  works.map((w) => {
    const k = studyKeyOf(w.key);
    return k ? aspectOf(`media/${w.slug}/${k}-800.webp`, 1.25) : Promise.resolve(null);
  }),
);
const museumWorks = works.map((w, wi) => {
  const entry = chapters.find((e) => e.id === w.slug)!;
  const hasSketch = w.key === "horizontal" && entry.data.media.images.includes("sketch");
  const studyKey = studyKeyOf(w.key);
  const hasStudy = Boolean(studyKey && entry.data.media.images.includes(studyKey));
  /* The plaque speaks a line from the day — the scene's APPROVED quote
     (never invented copy): the main canvas gets scene 1's, Part 2 gets
     scene 2's. */
  const scene =
    w.key === "horizontal-pt2" ? entry.data.scenes[1] : entry.data.scenes[0];
  return {
    slug: w.slug,
    key: w.key,
    title: w.title,
    /* The plaque sets the variant on its own line (juror pass 8: `· NARRATIVE /
       II` runted in the narrow 1024×768 card) — an authored two-line lockup. */
    name: entry.data.name.canonical,
    variant: PLAQUE_VARIANTS[w.slug]?.[w.key] ?? (KEY_TITLES[w.key] || null),
    order: w.order,
    tex1440: withBase(`media/${w.slug}/${w.key}-1440.jpg`),
    tex800: withBase(`media/${w.slug}/${w.key}-800.webp`),
    video: w.video,
    sketch: hasSketch ? withBase(`media/${w.slug}/sketch-800.webp`) : null,
    study: hasStudy ? withBase(`media/${w.slug}/${studyKey}-800.webp`) : null,
    studyAspect: hasStudy ? studyAspects[wi] : null,
    /* the chapter's own words about the drawing on screen — scene 2's note
       where the chapter has one (only Ch2 today), else the chapter's */
    studyNote: hasStudy
      ? (w.key === "horizontal-pt2" ? entry.data.scenes[1]?.sketchNote : null) ?? entry.data.sketchNote
      : null,
    aspect: aspects[wi],
    sketchAspect: hasSketch ? sketchAspects[wi] : null,
    line: (w.key === "horizontal" || w.key === "horizontal-pt2") && scene?.quote ? scene.quote.text : null,
    lineBy: (w.key === "horizontal" || w.key === "horizontal-pt2") && scene?.quote ? scene.quote.attribution : null,
  };
});
---

<Base
  title="The Paintings · Charles Nalle Walking Memorial"
  description="Mark Priest's Nalle Series: the cycle of paintings depicting the capture and rescue of Charles Nalle in Troy, NY, April 27, 1860."
  preloadImages={[
    { href: withBase("media/commissioners-office/horizontal-pt2-800.webp"), type: "image/webp", media: "(max-width: 767px)" },
    { href: withBase("media/commissioners-office/horizontal-pt2-1440.avif"), type: "image/avif", media: "(min-width: 768px)" },
  ]}
>
  <header class="shell page-open">
    <p class="t-meta">The paintings · {works.length} works</p>
    <h1 class="t-display lines mt-8" style={fitChars(PAINTINGS_HEADING)} set:html={PAINTINGS_HEADING} />
  </header>

  {/* THE MUSEUM (v6 signature). The window is SERVER-rendered at one
      viewport tall — the island expands it after mount, so nothing in view
      ever shifts (Lighthouse caught CLS 0.555 when the wrapper appeared
      client-side). Incapable visitors keep the window as a full-bleed lead
      painting; the grid below is the page either way, and stays the
      screen-reader surface always. */}
  <div id="museum-slot" class="relative mt-16 h-dvh">
    {/* One viewport tall regardless of how far the island expands the slot —
        the museum's opaque stage paints over it when active. */}
    <div class="absolute inset-x-0 top-0 h-dvh overflow-hidden">
      <picture>
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={withBase("media/commissioners-office/horizontal-pt2-800.webp")}
        />
        <source type="image/avif" srcset={withBase("media/commissioners-office/horizontal-pt2-1440.avif")} />
        <img
          src={withBase("media/commissioners-office/horizontal-pt2-1440.jpg")}
          alt="“Commissioner’s Office · Part 2”, the crowd of one thousand outside, painting by Mark Priest"
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div
        class="pointer-events-none absolute inset-0"
        style="background: linear-gradient(to top, rgba(29,20,17,.85), transparent 30%), linear-gradient(to bottom, rgba(29,20,17,.5), transparent 18%)"
      >
      </div>
      <p class="t-meta absolute bottom-6 left-[var(--gutter)]">Mark Priest · Nalle Series</p>
    </div>
    <Museum client:only="react" works={museumWorks} slotId="museum-slot" />
  </div>

  <section class="shell sec pb-8">
    <p class="t-prose reveal">
      Painter <strong>Mark Priest</strong> spent years reconstructing the rescue
      of Charles Nalle: walking Troy’s streets, reading the accounts, and
      painting the day scene by scene. Select any work to view it closely, or
      follow it into its&nbsp;chapter.
    </p>
    {/* v7 V7-090: under reduced motion the hall never mounts — say so, once. */}
    <p class="t-meta-body mt-4 hidden motion-reduce:block">
      The three-dimensional hall opens when your device allows motion; every work is here below.
    </p>

    <div class="beat grid gap-x-8 gap-y-16 sm:grid-cols-2">
      {
        works.map((work) => (
          <figure class="reveal">
            <button
              type="button"
              class="painting-open group block w-full cursor-pointer overflow-hidden rounded-[12px] text-left"
              data-full={work.full}
              data-video={work.video}
              data-title={`${work.title}, Mark Priest`}
              aria-label={`View “${work.title}” closely`}
            >
              <Picture
                slug={work.slug}
                imageKey={work.key}
                alt={`“${work.title}”, painting by Mark Priest`}
                sizes="(min-width: 640px) 34rem, 100vw"
                class="museum-tile w-full object-cover transition-transform group-hover:scale-[1.06] group-active:scale-[0.98]"
                style={`aspect-ratio: ${aspects[works.indexOf(work)]}`}
              />
            </button>
            {/* The fixed micro-grid: 16 → eyebrow → 12 → title → 12 → credit. */}
            <figcaption class="mt-4">
              <a
                href={work.href}
                data-curtain-label={work.mapLabel}
                data-curtain-date
                class="link-meta t-meta"
              >
                Location {String(work.order).padStart(2, "0")}
                <Icon name="arrow" size="sm" />
              </a>
              <span class="t-title-sm mt-3 block">{work.title}</span>
              <span class="t-meta-body mt-3 block">Mark Priest · Nalle Series</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* Close-look dialog. v5 P0-4: at 844×390 the caption + Close sat below
      the viewport — the media now takes what the caption row leaves, never
      more, so the chrome is always on screen. */}
  <dialog
    id="painting-dialog"
    class="artifact m-auto max-h-[94dvh] max-w-[94vw] bg-primary-2 p-0 backdrop:bg-black/88 open:flex open:flex-col"
  >
    <img
      id="painting-dialog-img"
      src=""
      alt=""
      class="min-h-0 w-auto max-w-full flex-1 object-contain"
    />
    <video
      id="painting-dialog-video"
      class="hidden min-h-0 w-auto max-w-full flex-1 object-contain"
      autoplay
      loop
      muted
      playsinline
    ></video>
    <div class="flex shrink-0 items-center justify-between gap-4 p-4">
      <p id="painting-dialog-title" class="t-meta-body"></p>
      <button type="button" id="painting-dialog-close" class="btn-sm btn-ghost">
        <Icon name="close" size="sm" />
        Close
      </button>
    </div>
  </dialog>

  <SiteFooter hide="paintings" />

  <script>
    const dialog = document.getElementById("painting-dialog") as HTMLDialogElement;
    const img = document.getElementById("painting-dialog-img") as HTMLImageElement;
    const title = document.getElementById("painting-dialog-title")!;
    const video = document.getElementById("painting-dialog-video") as HTMLVideoElement;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLButtonElement>(".painting-open").forEach((btn) => {
      btn.addEventListener("click", () => {
        const useVideo = Boolean(btn.dataset.video) && !reducedMotion;
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.title!;
        img.classList.toggle("hidden", useVideo);
        video.classList.toggle("hidden", !useVideo);
        if (useVideo) {
          video.src = btn.dataset.video!;
          video.poster = btn.dataset.full!;
          video.play().catch(() => {
            video.classList.add("hidden");
            img.classList.remove("hidden");
          });
        } else {
          video.pause();
          video.removeAttribute("src");
        }
        title.textContent = btn.dataset.title!;
        dialog.showModal();
      });
    });
    dialog.addEventListener("close", () => {
      video.pause();
      video.removeAttribute("src");
    });
    document
      .getElementById("painting-dialog-close")!
      .addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
