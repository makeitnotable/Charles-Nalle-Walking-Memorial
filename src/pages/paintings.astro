---
// The Paintings — Mark Priest's Nalle Series in the approved language
// (elevation G1: frame idiom, ladder type, Martel captions + credits).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import { withBase } from "../lib/url";

const chapters = (await getCollection("chapters")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Painting keys per chapter, in gallery order, with human titles. */
const KEY_TITLES: Record<string, string> = {
  horizontal: "",
  "horizontal-pt2": "Part 2",
  narrative1: "Narrative I",
  narrative2: "Narrative II",
};
/** Animated variant per painting key (elevation G2: the dialog plays the
 * painting alive where Mark Priest's animation exists). */
const KEY_VIDEOS: Record<string, string> = {
  horizontal: "reveal-horizontal",
  "horizontal-pt2": "reveal-horizontal-pt2",
  narrative1: "narrative1",
  narrative2: "narrative2",
};

const works = chapters.flatMap((entry) =>
  Object.keys(KEY_TITLES)
    .filter((key) => entry.data.media.images.includes(key))
    .map((key) => ({
      slug: entry.id,
      key,
      title: KEY_TITLES[key]
        ? `${entry.data.cardTitle} — ${KEY_TITLES[key]}`
        : entry.data.cardTitle,
      chapterLabel: entry.data.chapterLabel,
      order: entry.data.order,
      full: withBase(`media/${entry.id}/${key}-1440.jpg`),
      video: entry.data.media.videos.includes(KEY_VIDEOS[key])
        ? withBase(`media/${entry.id}/${KEY_VIDEOS[key]}.mp4`)
        : null,
      href: withBase(entry.id),
      mapLabel: entry.data.map.label,
    })),
);
---

<Base
  title="The Paintings — Charles Nalle Walking Memorial"
  description="Mark Priest's Nalle Series: the cycle of paintings depicting the capture and rescue of Charles Nalle in Troy, NY, April 27, 1860."
>
  <section class="mx-auto max-w-7xl px-4 pt-10 pb-24 md:px-10 lg:px-20">
    <p class="type-label reveal">The Paintings</p>
    <h1 class="type-display type-display-caps reveal mt-4">
      The Nalle<br />Series
    </h1>
    <p class="type-body reveal mt-8 max-w-xl">
      Painter <strong>Mark Priest</strong> spent years reconstructing the
      rescue of Charles Nalle — walking Troy's streets, reading the accounts,
      and painting the day scene by scene. Select any work to view it closely,
      or follow it into its chapter.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        works.map((work) => (
          <figure class="reveal">
            <button
              type="button"
              class="painting-open frame group block w-full cursor-pointer overflow-hidden text-left"
              data-full={work.full}
              data-video={work.video}
              data-title={`${work.title} — Mark Priest`}
              aria-label={`View “${work.title}” closely`}
            >
              <Picture
                slug={work.slug}
                imageKey={work.key}
                alt={`“${work.title}” — painting by Mark Priest`}
                sizes="(min-width: 640px) 34rem, 100vw"
                class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </button>
            <figcaption class="mt-3 flex items-baseline justify-between gap-4">
              <span>
                <span class="type-card-title block">{work.title}</span>
                <span class="type-muted">Mark Priest · Nalle Series</span>
              </span>
              <a
                href={work.href}
                data-curtain-label={work.mapLabel}
                data-curtain-date
                class="type-label shrink-0 transition-colors duration-300 hover:text-primary-9"
              >
                {work.chapterLabel} →
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* Close-look dialog */}
  <dialog
    id="painting-dialog"
    class="frame-2 m-auto max-h-[94dvh] max-w-[94vw] bg-primary-2 p-0 backdrop:bg-black/85"
  >
    <img id="painting-dialog-img" src="" alt="" class="max-h-[85dvh] w-auto" />
    <video
      id="painting-dialog-video"
      class="hidden max-h-[85dvh] w-auto"
      autoplay
      loop
      muted
      playsinline
    ></video>
    <div class="flex items-center justify-between gap-4 p-4">
      <p id="painting-dialog-title" class="type-muted"></p>
      <button
        type="button"
        id="painting-dialog-close"
        class="cursor-pointer rounded-full border border-primary-8 px-4 py-1.5 text-sm font-medium text-primary-11 transition-colors duration-300 hover:text-primary-12"
        style="font-family: var(--font-poppins)"
      >
        Close
      </button>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById("painting-dialog") as HTMLDialogElement;
    const img = document.getElementById("painting-dialog-img") as HTMLImageElement;
    const title = document.getElementById("painting-dialog-title")!;
    const video = document.getElementById("painting-dialog-video") as HTMLVideoElement;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLButtonElement>(".painting-open").forEach((btn) => {
      btn.addEventListener("click", () => {
        const useVideo = Boolean(btn.dataset.video) && !reducedMotion;
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.title!;
        img.classList.toggle("hidden", useVideo);
        video.classList.toggle("hidden", !useVideo);
        if (useVideo) {
          video.src = btn.dataset.video!;
          video.poster = btn.dataset.full!;
          video.play().catch(() => {
            video.classList.add("hidden");
            img.classList.remove("hidden");
          });
        } else {
          video.pause();
          video.removeAttribute("src");
        }
        title.textContent = btn.dataset.title!;
        dialog.showModal();
      });
    });
    dialog.addEventListener("close", () => {
      video.pause();
      video.removeAttribute("src");
    });
    document
      .getElementById("painting-dialog-close")!
      .addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
