---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
import { rescuers, hunters, type Person } from "../data/people";

const chapters = await getCollection("chapters");
const labelFor = (slug: string) =>
  chapters.find((c) => c.id === slug)?.data.map.label ?? slug;

const groups: { heading: string; blurb: string; people: Person[] }[] = [
  {
    heading: "The Rescuers",
    blurb:
      "Black and white, famous and unrecorded — the people of Troy who decided, in a single afternoon, that the law was wrong.",
    people: rescuers,
  },
  {
    heading: "The Hunters",
    blurb:
      "The men who put a free man in chains — lawfully, under the Fugitive Slave Act of 1850.",
    people: hunters,
  },
];
---

<Base
  title="The People — Charles Nalle Walking Memorial"
  description="The rescuers and the hunters of April 27, 1860: Harriet Tubman, Peter Baltimore, Martin Townsend, Uri Gilbert — and the men who tried to drag Charles Nalle back into slavery."
>
  <section class="mx-auto max-w-3xl px-6 pt-10 pb-24">
    <p class="label-caps">The People</p>
    <h1 class="display-hero mt-4 text-5xl sm:text-6xl">
      One day.<br />A whole city's cast.
    </h1>
    <p class="prose-narrative mt-6 opacity-90">
      Every name below stood on real pavement you can still walk. Follow any of
      them into the chapter where their part of the story is told.
    </p>

    {
      groups.map((group) => (
        <section class="mt-16" aria-label={group.heading}>
          <h2 class="font-display text-3xl" style="color: var(--chapter-accent)">
            {group.heading}
          </h2>
          <p class="mt-2 max-w-xl opacity-75">{group.blurb}</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {group.people.map((person) => (
              <article class="reveal rounded-sm border border-white/12 p-5">
                <h3 class="font-display text-2xl">{person.name}</h3>
                <p class="label-caps mt-1" style="color: var(--chapter-accent)">
                  {person.role}
                </p>
                <p class="mt-3 leading-relaxed opacity-90">{person.note}</p>
                <p class="mt-4 flex flex-wrap gap-2">
                  {person.chapters.map((slug) => (
                    <a
                      href={withBase(slug)}
                      class="rounded-full border border-white/20 px-3 py-1 text-xs tracking-wide hover:border-white/50"
                    >
                      {labelFor(slug)} →
                    </a>
                  ))}
                </p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
