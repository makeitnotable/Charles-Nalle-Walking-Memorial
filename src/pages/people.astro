---
/**
 * The People — the cast of April 27, 1860.
 * v4: unboxed. v3 put 21 bordered cards in one viewport and nothing won the
 * glance. Each person is now an eyebrow/name/note stack on a hairline — the
 * Google Arts & Culture micro-grid with the image slot empty (portraits are
 * still an undelivered asset; see docs/v4/REVIEW-GUIDE.md).
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";
import { rescuers, hunters, type Person } from "../data/people";

const chapters = await getCollection("chapters");
const shortFor = (slug: string) =>
  chapters.find((c) => c.id === slug)?.data.name.short ?? slug;
const orderFor = (slug: string) => chapters.find((c) => c.id === slug)?.data.order ?? 0;

const groups: { heading: string; blurb: string; people: Person[] }[] = [
  {
    heading: "The rescuers",
    blurb:
      "Black and white, famous and unrecorded — the people of Troy who decided, in a single afternoon, that the law was wrong.",
    people: rescuers,
  },
  {
    heading: "The hunters",
    blurb:
      "The men who put a free man in chains — lawfully, under the Fugitive Slave Act of 1850.",
    people: hunters,
  },
];
---

<Base
  title="The People — Charles Nalle Walking Memorial"
  description="The rescuers and the hunters of April 27, 1860: Harriet Tubman, Peter Baltimore, Martin Townsend, Uri Gilbert — and the men who tried to drag Charles Nalle back into slavery."
>
  <header class="shell pt-28 pb-4">
    <p class="t-meta">The people</p>
    <h1 class="t-display lines mt-8" style="--fit-chars: 14">
      ONE DAY.<br />A WHOLE CITY'S CAST.
    </h1>
  </header>

  {/* Her words first. */}
  <section class="shell beat">
    <figure class="reveal-quote">
      <blockquote class="t-quote is-hung">
        “Drag us out! Drag him to the river! Drown him! But don't let them have him!”
      </blockquote>
      <figcaption class="t-meta mt-6">— Harriet Tubman, outside the commissioner's office</figcaption>
    </figure>
    <p class="t-prose reveal beat">
      Every name below stood on real pavement you can still walk. Follow any of
      them into the chapter where their part of the story is told.
    </p>
  </section>

  {
    groups.map((group, gi) => (
      <section class="shell sec" aria-label={group.heading}>
        <div class="sec-head"></div>
        <div class="editorial mt-8">
          <div class="rail">
            <p class="t-spine">({String(gi + 1).padStart(2, "0")})</p>
            <p class="t-meta mt-3">{group.heading}</p>
          </div>

          <div>
            <h2 class="t-title reveal">{group.heading}</h2>
            <p class="t-prose reveal mt-8">{group.blurb}</p>

            <div class="mt-16 grid gap-x-12 gap-y-0 md:grid-cols-2">
              {group.people.map((person) => (
                <article class="reveal rule-top py-8">
                  <p class="t-meta">{person.role}</p>
                  <h3 class="t-title-sm mt-3">
                    {person.name}
                  </h3>
                  <p class="t-prose mt-4">{person.note}</p>
                  <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
                    {person.chapters.map((slug) => (
                      <a
                        href={withBase(slug)}
                        data-curtain-label={shortFor(slug)}
                        data-curtain-date
                        class="link-meta t-meta"
                      >
                        Stop {orderFor(slug)} · {shortFor(slug)}
                        <Icon name="arrow" size="sm" />
                      </a>
                    ))}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* No dead ends. */}
  <section class="shell sec">
    <div class="sec-head"></div>
        <div class="editorial mt-8">
      <div class="rail">
        <p class="t-spine">(03)</p>
        <p class="t-meta mt-3">Onward</p>
      </div>
      <div>
        <p class="t-meta">Their streets are still here</p>
        <h2 class="t-title reveal mt-4">Walk the route</h2>
        <div class="mt-10">
          <a href={withBase("map")} data-curtain-label="The Walk" class="btn btn-solid">
            Open the walk
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter hide="people" />

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal, .reveal-quote, .lines").forEach((el) => io.observe(el));
  </script>
</Base>
