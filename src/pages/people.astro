---
// The People — the cast of April 27, 1860, in the approved language.
// Elevation P1/P2 (googleac subject-spine): the page leads with Tubman's
// words; role eyebrow labels; "appears in" chips tie people to chapters.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
import { rescuers, hunters, type Person } from "../data/people";

const chapters = await getCollection("chapters");
const labelFor = (slug: string) =>
  chapters.find((c) => c.id === slug)?.data.map.label ?? slug;
const orderFor = (slug: string) =>
  chapters.find((c) => c.id === slug)?.data.order ?? 0;

const groups: { heading: string; blurb: string; people: Person[] }[] = [
  {
    heading: "The Rescuers",
    blurb:
      "Black and white, famous and unrecorded — the people of Troy who decided, in a single afternoon, that the law was wrong.",
    people: rescuers,
  },
  {
    heading: "The Hunters",
    blurb:
      "The men who put a free man in chains — lawfully, under the Fugitive Slave Act of 1850.",
    people: hunters,
  },
];
---

<Base
  title="The People — Charles Nalle Walking Memorial"
  description="The rescuers and the hunters of April 27, 1860: Harriet Tubman, Peter Baltimore, Martin Townsend, Uri Gilbert — and the men who tried to drag Charles Nalle back into slavery."
>
  <section class="mx-auto max-w-7xl px-4 pt-10 pb-24 md:px-10 lg:px-20">
    <p class="type-label reveal">The People</p>
    <h1 class="type-display type-display-caps reveal mt-4">
      One day.<br />A whole city's cast.
    </h1>

    {/* The page leads with her words (quote-first spine) */}
    <figure class="reveal mt-10 max-w-2xl">
      <blockquote class="type-card-title" style="font-size: 1.35em; line-height: 1.4">
        “Drag us out! Drag him to the river! Drown him! But don't let them have
        him!”
      </blockquote>
      <figcaption class="type-label mt-3">
        — Harriet Tubman, outside the commissioner's office
      </figcaption>
    </figure>

    <p class="type-body reveal mt-8 max-w-xl">
      Every name below stood on real pavement you can still walk. Follow any of
      them into the chapter where their part of the story is told.
    </p>

    {
      groups.map((group) => (
        <section class="mt-16" aria-label={group.heading}>
          <h2 class="type-display type-display-caps reveal">{group.heading}</h2>
          <p class="type-body reveal mt-4 max-w-xl">{group.blurb}</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {group.people.map((person) => (
              <article class="reveal frame flex flex-col bg-primary-3 p-5">
                <p class="type-label">{person.role}</p>
                <h3 class="type-card-title mt-2 uppercase">{person.name}</h3>
                <p class="type-body mt-3 flex-1">{person.note}</p>
                <p class="mt-5 flex flex-wrap gap-2">
                  {person.chapters.map((slug) => (
                    <a
                      href={withBase(slug)}
                      data-curtain-label={labelFor(slug)}
                      data-curtain-date
                      class="rounded-full border border-primary-8 px-3 py-1.5 text-xs font-medium text-primary-11 transition-colors duration-300 hover:border-primary-7 hover:text-primary-12"
                      style="font-family: var(--font-poppins)"
                    >
                      Ch. {orderFor(slug)} · {labelFor(slug)} →
                    </a>
                  ))}
                </p>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    {/* No dead ends */}
    <a
      href={withBase("map")}
      data-curtain-label="The Walk"
      class="reveal frame mt-16 flex items-center justify-between bg-primary-3 p-6 transition-colors duration-300 hover:bg-primary-4 md:p-8"
    >
      <span>
        <span class="type-label block">Their streets are still here</span>
        <span class="type-card-title mt-2 block uppercase">Walk the route</span>
      </span>
      <span class="type-display" aria-hidden="true">→</span>
    </a>
  </section>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
