# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables (.env.production is deliberately committed — it holds
# only the publishable Mapbox pk. token that ships in the client bundle anyway;
# rationale in docs/DEVIATIONS.md, hardening/migration in docs/WIL-PLAYBOOK.md)
.env
!.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# v4 QA screenshots: evidence lives on disk; only curated before/after JPEGs are
# committed (docs/v4/qa/before-after/). PNG matrices would add ~50MB per phase.
docs/v4/qa/**/*.png
!docs/v4/qa/before-after/**

# v5 audit screenshots (evidence, regenerable — the findings are the artefact)
docs/v5/qa/
